# ===== 必填 =====
ANTHROPIC_API_KEY=sk-ant-xxxxx

# ===== WebUI / Live 頁面 =====
# 啟用後可透過瀏覽器管理 agent、查看 Live 辦公室
WEBUI_ENABLED=false
WEBUI_PORT=3001
# 以下兩項在 WEBUI_ENABLED=true 時必填，否則啟動會報錯
WEBUI_PASSWORD=your-secure-password
WEBUI_JWT_SECRET=change-this-to-a-random-string

# ===== 語音輸入（Speech-to-Text）=====
# 啟用後 Telegram 語音訊息會自動轉文字處理
STT_ENABLED=false
STT_PROVIDER=groq
STT_API_KEY=
STT_MODEL=whisper-large-v3-turbo

# ===== 語音輸出（Text-to-Speech）=====
# 啟用後可讓 Agent 發送語音訊息
TTS_ENABLED=false
TTS_PROVIDER=replicate
REPLICATE_API_TOKEN=
TTS_MODEL=minimax/speech-2.8-turbo
TTS_DEFAULT_VOICE_ID=

# ===== 安全 =====
# 限制可使用 bot 的 Telegram user ID（逗號分隔，留空 = 不限制）
ALLOWED_USERS=
MAX_MESSAGE_LENGTH=10000
PROMPT_INJECTION_DETECTION=true

# ===== 持久化 =====
# 啟用 SQLite 儲存對話、session、活動事件（Live 頁面需要）
ENABLE_PERSISTENCE=false
DB_PATH=./data/claudecab.db

# ===== Session =====
SESSION_TIMEOUT_MS=3600000
CLEANUP_INTERVAL_MS=60000
MAX_SESSIONS=1000

# ===== 其他 =====
LOG_LEVEL=info
AUDIT_LOGGING=true
WEBUI_SESSION_EXPIRE=86400000

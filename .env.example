# =============================================================================
# ClaudeCab 環境設定
# =============================================================================
# 複製此檔案為 .env 後修改：
#   cp .env.example .env
#
# 部署選項：
#   1) 本機開發：直接用 .env，大多數值走預設即可
#   2) Docker 部署： secrets 不要寫死 .env，改用 Docker secrets 或
#      runtime injection
#   3) 雲端 VM：secrets 放環境變數或 secrets manager，不要 commit .env
# =============================================================================

# ─── 認證方式 ────────────────────────────────────────────────────────────────
# ClaudeCab 支援兩種認證方式，二選一：
#
# [A] API Key（傳統方式，目前最快上手）
#   ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
#   優點：設定簡單，可搭配第三方 proxy（如 DeepSeek）
#   缺點：金鑰明碼，需妥善保管
#
# [B] OAuth（推薦 for 雲端/正式部署）
#   在部署機器上先執行一次：
#     claude login
#   然後「不要」設 ANTHROPIC_API_KEY，系統會自動走 OAuth
#   優點：不需管理金鑰字串，憑證存在 ~/.claude/credentials.json
#   缺點：不支援第三方 proxy（OAuth 只能直連 Anthropic API）
#
# 兩者都留空 => SDK bundle 的 CLI 會去 ~/.claude/ 找 OAuth 憑證
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=          # 第三方 proxy 用（OAuth 模式下不要設）


# ─── Agent 來源目錄 ──────────────────────────────────────────────────────────
# 指向 agent 設定檔（agent.json、CLAUDE.md、skills 等）的根目錄
# 預設：./agents （即本機 repo 內的 agents/ 目錄）
#
# 情境：
#   本機開發：指向 D:\_CabLate_Agents（與 Claude Code CLI 共用 agent 設定）
#   雲端部署：用 ./agents 或 repo 內的 agents/，確保路徑在 container 內存在
AGENTS_DIR=./agents


# ─── Discord 整合（必要） ──────────────────────────────────────────────────
# 每個 agent 有自己的 discordBotToken（在 agent.json 設定）
# 這裡是「系統 bot」— 負責 slash command、儀表板 Embed、成本報告
DISCORD_ENABLED=true
DISCORD_MAIN_BOT_TOKEN=           # Discord Bot Token（必填）
DISCORD_MAIN_BOT_CLIENT_ID=       # Discord Application ID（必填）
DISCORD_GUILD_ID=                 # Discord Server ID（必填）
DISCORD_OWNER_USER_ID=            # 你的 Discord User ID（接收 DM 通知）
# Discord 頻道 ID（選填但建議全設）
DISCORD_CHANNEL_DASHBOARD=        # 系統儀表板
DISCORD_CHANNEL_COST_REPORT=      # 每日成本報告
DISCORD_CHANNEL_ALERTS=           # 錯誤/警告通知
DISCORD_CHANNEL_TASK_BOARD=       # 任務看板
DISCORD_CHANNEL_SYSTEM_LOG=       # 系統日誌
IN_CHAT_USAGE_SUMMARY_ENABLED=true # 設 false 隱藏對話內 tool 狀態訊息 & 用量卡片（events、usage card）
DISCORD_DASHBOARD_UPDATE_MINUTES=15  # 儀表板更新間隔（分鐘）


# ─── V2 Session Guard（可依需求關閉） ──────────────────────────────────────
# 這兩個是你之前提到的「150K 阻攔」和「Idle Guard」的開關：
#
# SESSION_GUARD_ENABLED=false           # ← 完全關閉 Token 長度檢查
# SESSION_GUARD_TOKEN_THRESHOLD=9999999 # ← 或設超大永不觸發
# SESSION_GUARD_CACHE_TTL_MS=999999999  # ← 關閉 Cache 過期檢查
#
SESSION_GUARD_ENABLED=true
SESSION_GUARD_TOKEN_THRESHOLD=300000    # Token 超過此值跳出「Session 太長」對話
SESSION_GUARD_CACHE_TTL_MS=300000       # 閒置超過此毫秒跳出「Cache 已過期」對話

# V2 cache keepalive ping（保 prompt cache 用）
# 設 false 則完全不發 keepalive，cache 可能在 5 分鐘後過期
CACHE_KEEPALIVE_ENABLED=true
CACHE_KEEPALIVE_INTERVAL_MS=180000
CACHE_KEEPALIVE_SKIP_RECENT_MS=180000
CACHE_KEEPALIVE_DETECTED_TTL_RATIO=0.6
CACHE_KEEPALIVE_MIN_INTERVAL_MS=60000
CACHE_KEEPALIVE_QUERYING_RETRY_MS=15000
CACHE_KEEPALIVE_ALERT_COOLDOWN_MS=3600000
CACHE_EFFICIENCY_WARN_THRESHOLD=50

# Session timeout（session 閒置多久自動清理）
SESSION_TIMEOUT_MS=3600000         # 1 小時（雲端可設更長）
CLEANUP_INTERVAL_MS=60000          # 清理檢查間隔
MAX_SESSIONS=1000                  # 最大同時 session 數
DB_RETENTION_MS=2592000000         # 資料保留天數（30 天）

# Ephemeral mode — 每次 query 用完即銷毀 SDK CLI process，釋放 ~150MB RAM
# resume 資料保留在磁碟 JSONL，下次 query 自動恢復對話脈絡
# 適合 Q&A bot / 資源受限部署。預設 false（保留既有 persistent 行為）
SESSION_EPHEMERAL=false


# ─── 語音輸入/輸出（選用） ────────────────────────────────────────────────
STT_ENABLED=false
STT_PROVIDER=groq
STT_API_KEY=
STT_MODEL=whisper-large-v3-turbo

TTS_ENABLED=false
TTS_PROVIDER=replicate
REPLICATE_API_TOKEN=
TTS_MODEL=minimax/speech-2.8-turbo
TTS_DEFAULT_VOICE_ID=


# ─── 安全性 ──────────────────────────────────────────────────────────────────
ALLOWED_USERS=                     # 逗號分隔的 Discord User ID（留空 = 全部允許）
MAX_MESSAGE_LENGTH=10000           # 單則訊息最大字元數
PROMPT_INJECTION_DETECTION=true    # 提示注入偵測


# ─── 資料庫（SQLite 持久化） ──────────────────────────────────────────────
ENABLE_PERSISTENCE=true            # 建議雲端開啟
DB_PATH=./data/claudecab.db        # SQLite 檔案路徑
# 注意：SQLite 不適合多實例。雲端若要水平擴展，需改 PostgreSQL


# ─── Claude Code CLI ────────────────────────────────────────────────────────
# 如果要指定外部安裝的 claude.exe（而非 SDK bundle 的），取消註解並填路徑
# 雲端部署時留空即可，SDK 會自動用 node_modules 內的 bundle CLI
# CLAUDE_CLI_PATH=

# ─── 日誌 ────────────────────────────────────────────────────────────────────
LOG_LEVEL=info                     # debug | info | warn | error
AUDIT_LOGGING=true


# ─── 部署備忘 ──────────────────────────────────────────────────────────────
#
# Docker 部署：
#   1. docker compose build
#   2. docker compose up -d
#   3. 確保 AGENTS_DIR 路徑在 container 內存在（預設 ./agents OK）
#   4. Discord token 等 secrets 建議用 Docker secrets 而非 .env
#   5. 如果 CLI 要用 OAuth，需在 image build 時先 claude login
#      （或掛載 ~/.claude/ 目錄進 container）
#
# 雲端 VM 直接部署：
#   1. git clone 此 repo（cloud-deploy 分支）
#   2. cp .env.example .env 並填入設定
#   3. npm ci --production
#   4. node start.ts（或 PM2 / systemd）
#   5. secrets 從環境變數或 secrets manager 讀取，不要寫在 .env 裡
#
# 關於 OAuth：
#   - 雲端 VM 上先跑一次 claude login
#   - OAuth token 存在 ~/.claude/credentials.json
#   - 不要設 ANTHROPIC_API_KEY，系統會自動走 OAuth
#   - OAuth 模式不能配第三方 proxy（ANTHROPIC_BASE_URL 必須留空）

# ClaudeCab 最小設定範本
#
# 使用方式：
#   cp .env.example .env
#   然後只填「必填」區塊。
#
# 不要 commit .env、Discord token、Claude key、真實 agents 內容。

# =============================================================================
# 必填：Discord 主 Bot
# =============================================================================
# 主 Bot 負責 slash command、互動按鈕、系統訊息。
DISCORD_ENABLED=true
DISCORD_MAIN_BOT_TOKEN=
DISCORD_MAIN_BOT_CLIENT_ID=
DISCORD_GUILD_ID=

# =============================================================================
# 必填：Agent 設定資料夾
# =============================================================================
# 預設使用 repo 內的 ./agents。
# 只有 agents/example 會被 git 追蹤；你自己的 agents/* 預設會被 .gitignore 排除。
AGENTS_DIR=./agents

# =============================================================================
# 必填：Claude 認證，二選一
# =============================================================================
# 方式 A：用 API key（不需要 Claude 訂閱）。
ANTHROPIC_API_KEY=

# 方式 B：用 Claude Code OAuth（需要 Claude Pro / Max 訂閱）。
# 前提：先在部署機器全域裝 Claude Code CLI，再 login（會開瀏覽器）：
#   npm install -g @anthropic-ai/claude-code
#   claude login
# 然後讓 ANTHROPIC_API_KEY 保持空白。
# SSH / Docker / 雲端等無瀏覽器環境的替代方案見 docs/SETUP.md 與
# .claude/skills/claudecab-deploy/references/troubleshooting.md。

# =============================================================================
# 常用選填
# =============================================================================
# 如果要接 Anthropic-compatible proxy / 其他模型服務：
# 建議放在 agents/example/.claude/settings.local.json 的 env 裡，
# 讓 Claude Code 以該 agent 目錄為 cwd 時自行讀取。
#
# 只有你確定所有 agents 都共用同一組 provider 時，才放全域 .env。
# 使用 claude login / OAuth 時不要設定 ANTHROPIC_BASE_URL。
ANTHROPIC_BASE_URL=

# 持久化建議開啟，讓 session、schedule thread、metrics 可恢復。
ENABLE_PERSISTENCE=true
DB_PATH=./data/claudecab.db

# 擁有者 Discord User ID。設定後 schedule thread 建立時可通知/加入你。
DISCORD_OWNER_USER_ID=

# 顯示時區（IANA 名稱）。用於 dashboard、crash 通知、prompt context 的時間顯示。
# 預設 UTC。範例：Asia/Taipei、America/New_York。
# 注意：各 schedule 的觸發時區是在 schedule YAML 自己指定，與此無關。
DISPLAY_TIMEZONE=

# 顯示語言（dashboard、時間標籤、日期格式）。預設 en。範例：zh-TW、en。
DISPLAY_LOCALE=

# 小型 admin console 預設關閉。啟用後只綁 localhost，API 需要 token。
# 如果部署在 Docker/cloud，建議把 ./data 掛成 volume，讓 local config overlay 持久化。
ADMIN_CONSOLE_ENABLED=false
ADMIN_CONSOLE_HOST=127.0.0.1
ADMIN_CONSOLE_PORT=47824
ADMIN_CONSOLE_TOKEN=
CLAUDECAB_LOCAL_CONFIG_PATH=./data/claudecab.local.json

# =============================================================================
# 進階設定：一般使用者先不要改
# =============================================================================
# SCHEDULE_ENABLED=true
# SCHEDULE_CATCHUP_ENABLED=true
# SCHEDULE_CATCHUP_CHECK_INTERVAL_MS=1800000
# SCHEDULE_CATCHUP_GRACE_MS=1800000
# SCHEDULE_CATCHUP_WINDOW_MS=10800000
# SCHEDULE_STALE_RUNNING_MS=7200000
# SESSION_EPHEMERAL=false
# SESSION_IDLE_CLOSE_MS=7200000
# SESSION_QUERY_HARD_TIMEOUT_MS=3600000
# SESSION_TIMEOUT_MS=3600000
# MAX_SESSIONS=1000
#
# CACHE_KEEPALIVE_ENABLED=true
# CACHE_KEEPALIVE_INTERVAL_MS=60000
# CACHE_KEEPALIVE_SKIP_RECENT_MS=15000
#
# SESSION_GUARD_ENABLED=true
# SESSION_GUARD_TOKEN_THRESHOLD=150000
# SESSION_GUARD_CACHE_TTL_MS=300000
#
# DISCORD_CHANNEL_DASHBOARD=
# DISCORD_CHANNEL_COST_REPORT=
# DISCORD_CHANNEL_ALERTS=
# DISCORD_CHANNEL_SYSTEM_LOG=
# DISCORD_DASHBOARD_UPDATE_MINUTES=15
#
# STT_ENABLED=false
# STT_PROVIDER=groq
# STT_API_KEY=
# STT_MODEL=whisper-large-v3-turbo
#
# ALLOWED_USERS=

# ClaudeCab environment example
#
# Copy this file to .env and fill in your local values:
#   cp .env.example .env
#
# Never commit .env, Discord tokens, Claude credentials, or live agent folders.

# Discord
DISCORD_ENABLED=true
DISCORD_MAIN_BOT_TOKEN=
DISCORD_MAIN_BOT_CLIENT_ID=
DISCORD_GUILD_ID=
DISCORD_OWNER_USER_ID=

# Optional operational channels
DISCORD_CHANNEL_DASHBOARD=
DISCORD_CHANNEL_COST_REPORT=
DISCORD_CHANNEL_ALERTS=
DISCORD_CHANNEL_SYSTEM_LOG=
DISCORD_DASHBOARD_UPDATE_MINUTES=15

# Agent profiles
# Agents are loaded from this external folder. Keep live credentials out of git.
AGENTS_DIR=./agents

# Claude authentication
# Use either an API key or host-level Claude Code OAuth credentials.
# Leave ANTHROPIC_API_KEY empty when using `claude login`.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
CLAUDE_CLI_PATH=

# Sessions
SESSION_EPHEMERAL=false
SESSION_IDLE_CLOSE_MS=7200000
SESSION_QUERY_HARD_TIMEOUT_MS=3600000
SESSION_QUERY_HARD_TIMEOUT_GRACE_MS=30000
SESSION_TIMEOUT_MS=3600000
MAX_SESSIONS=1000

# Session guard
SESSION_GUARD_ENABLED=true
SESSION_GUARD_TOKEN_THRESHOLD=300000
SESSION_GUARD_CACHE_TTL_MS=300000

# Prompt-cache keepalive
CACHE_KEEPALIVE_ENABLED=true
CACHE_KEEPALIVE_INTERVAL_MS=180000
CACHE_KEEPALIVE_SKIP_RECENT_MS=180000
CACHE_KEEPALIVE_DETECTED_TTL_RATIO=0.6
CACHE_KEEPALIVE_MIN_INTERVAL_MS=60000
CACHE_KEEPALIVE_QUERYING_RETRY_MS=15000
CACHE_KEEPALIVE_ALERT_COOLDOWN_MS=3600000
CACHE_EFFICIENCY_WARN_THRESHOLD=50

# Persistence
ENABLE_PERSISTENCE=true
DB_PATH=./data/claudecab.db
DB_RETENTION_MS=2592000000

# Schedules
SCHEDULE_ENABLED=true

# Speech-to-text for Discord attachments
STT_ENABLED=false
STT_PROVIDER=groq
STT_API_KEY=
STT_MODEL=whisper-large-v3-turbo

# Safety and logging
ALLOWED_USERS=
MAX_MESSAGE_LENGTH=10000
PROMPT_INJECTION_DETECTION=true
IN_CHAT_USAGE_SUMMARY_ENABLED=true
USAGE_CARD_ENABLED=true
LOG_LEVEL=info
AUDIT_LOGGING=true

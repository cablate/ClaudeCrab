# Anthropic API
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Telegram Bot
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Application Settings
DEFAULT_AGENT=general
LOG_LEVEL=info

# Security Settings
# Comma-separated Telegram user IDs (empty = allow all)
ALLOWED_USERS=
# Maximum message length in characters (default: 10000)
MAX_MESSAGE_LENGTH=10000
# Enable/disable prompt injection detection (default: true)
PROMPT_INJECTION_DETECTION=true
# Enable/disable audit logging (default: true)
AUDIT_LOGGING=true

# Session Settings
SESSION_TIMEOUT_MS=3600000
CLEANUP_INTERVAL_MS=60000
MAX_SESSIONS=1000

# Persistence Settings
# Enable SQLite persistence for sessions and conversations (default: false)
ENABLE_PERSISTENCE=false
# Path to SQLite database file (default: ./data/claudecab.db)
DB_PATH=./data/claudecab.db

# WebUI Settings
# Enable the WebUI admin panel (default: false)
WEBUI_ENABLED=false
# Port for the WebUI server (default: 3001)
WEBUI_PORT=3001
# Password for WebUI authentication (required if WEBUI_ENABLED=true)
WEBUI_PASSWORD=your-secure-password
# JWT secret for session tokens (recommended to change in production)
WEBUI_JWT_SECRET=change-this-to-a-random-string
# Session expiration in milliseconds (default: 86400000 = 24 hours)
WEBUI_SESSION_EXPIRE=86400000

{
  "name": "claudecab",
  "version": "1.2.0",
  "description": "Discord conversation workbench powered by Claude Agent SDK",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "postinstall": "node scripts/patch-sdk-v2.cjs",
    "setup": "tsx scripts/setup.ts",
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node --import tsx start.ts",
    "start:direct": "node --import tsx src/index.ts",
    "prod:start": "schtasks /run /tn ClaudeCab",
    "prod:stop": "node scripts/claudecab-runtime.mjs stop",
    "prod:restart": "node scripts/claudecab-runtime.mjs restart",
    "prod:status": "node scripts/claudecab-runtime.mjs status",
    "prod:logs": "tail -f logs/supervisor-out.log",
    "prod:install": "scripts\\install-service.bat",
    "prod:uninstall": "schtasks /delete /tn ClaudeCab /f",
    "test": "vitest",
    "test:run": "vitest run",
    "quality-gate": "bash scripts/quality-gate.sh",
    "validate:agent-workspace": "node scripts/validate-agent-workspace.mjs",
    "validate:agent-workspace:json": "node scripts/validate-agent-workspace.mjs --json",
    "validate:external-repos": "node scripts/validate-external-repos.mjs",
    "scan:general-governance": "node scripts/scan-general-workspace-governance.mjs",
    "render:general-workspace-map": "npm run scan:general-governance && node scripts/render-general-workspace-map.mjs",
    "lint": "eslint src",
    "lint:logs": "node scripts/lint-logs.mjs --warn",
    "lint:logs:strict": "node scripts/lint-logs.mjs",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "trace:cache": "tsx scripts/trace-cache-anomaly.ts"
  },
  "keywords": [
    "claude",
    "discord",
    "conversation",
    "bot",
    "ai"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.119",
    "adm-zip": "^0.5.16",
    "async-mutex": "^0.5.0",
    "better-sqlite3": "^12.6.2",
    "chokidar": "^5.0.0",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "discord.js": "^14.25.1",
    "dotenv": "^17.2.3",
    "node-cron": "^4.2.1",
    "pino": "^10.3.0",
    "pino-roll": "^4.0.0",
    "replicate": "^1.4.0",
    "sound-play": "^1.1.0",
    "uuid": "^13.0.0",
    "yaml": "^2.8.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@inquirer/prompts": "^8.2.0",
    "@types/adm-zip": "^0.5.7",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.19.11",
    "@types/node-cron": "^3.0.11",
    "@typescript-eslint/eslint-plugin": "^8.53.1",
    "@typescript-eslint/parser": "^8.53.1",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.1.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.1",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cablate/ClaudeCrab.git"
  },
  "types": "./dist/index.d.ts",
  "bugs": {
    "url": "https://github.com/cablate/ClaudeCrab/issues"
  },
  "homepage": "https://github.com/cablate/ClaudeCrab#readme"
}

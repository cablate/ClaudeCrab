{
  "model": "sonnet",
  "permissions": {
    "allow": ["Read", "Write", "Edit", "Glob", "Grep", "WebFetch", "WebSearch", "mcp__serena__*"],
    "deny": []
  },
  "hooks": {
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "npx tsx ../_shared/hooks/memory-stop-checkpoint.ts"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|Bash|Read|Glob|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "npx tsx ../_shared/hooks/path-validator.ts"
          }
        ]
      }
    ]
  }
}

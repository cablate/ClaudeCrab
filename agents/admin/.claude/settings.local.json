{
  "permissions": {
    "allow": [
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "Bash",
      "mcp__serena__*"
    ],
    "deny": [
      "mcp__twse__*"
    ]
  },
  "model": "opus",
  "hooks": {
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "npx tsx ../_shared/hooks/memory-stop-checkpoint.ts"
          }
        ]
      }
    ]
  }
}

    {
      "parameters": {
        "jsCode": "return $input.all().map(item => {\n  const html = item.json.data;\n  if (!html) return { json: { handle: null, error: \"input_url 回傳內容為空\" } };\n  const scriptMatch = html.match(/<script type=\"application\\/json-rpc\">([\\s\\S]*?)<\\/script>/);\n  if (!scriptMatch) return { json: { handle: null, error: \"找不到 <script type=application/json-rpc>\" } };\n  let jsonStr = scriptMatch[1].trim();\n  let json;\n  try { json = JSON.parse(jsonStr); } catch (e) { return { json: { handle: null, error: \"解析 script 內 JSON 失敗: \" + e } }; }\n  let handle = null;\n  if (Array.isArray(json) && json[1] && typeof json[1][2] === 'string') { handle = json[1][2]; }\n  else {\n    for (const arr of json) {\n      if (Array.isArray(arr)) {\n        for (const v of arr) {\n          if (typeof v === 'string' && v.length > 30) {\n            handle = v;\n            break;\n          }\n        }\n      }\n      if (handle) break;\n    }\n  }\n  \n  return { json: { handle } };\n});"
      },

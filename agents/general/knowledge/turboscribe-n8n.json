      "parameters": {
        "jsCode": "// 正規表達式來匹配 script 標籤並提取內容\n  const regex = /<script\\s+type=\"application\\/json-rpc\"[^>]*>(\\[\\[.*?\\]\\])<\\/script>/s;\n\n  // 提取並解析 JSON 內容，取得第二個子項目\n  const extractSecondItem = (html) => {\n    const match = html.match(regex);\n    if (match) {\n      try {\n        const jsonArray = JSON.parse(match[1]);\n        // 取得主陣列的第二個元素（索引為1）\n        if (jsonArray.length > 1) {\n          return jsonArray[1];\n        }\n      } catch (e) {\n        console.error('JSON 解析錯誤:', e);\n      }\n    }\n    return null;\n  };\n const datas = extractSecondItem($input.first().json.data)\n return { data: datas?.[1] }"
      },

<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - ClaudeCab Admin</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 min-h-screen flex items-center justify-center">
  <div class="max-w-md w-full mx-4 text-center">
    <div class="bg-white rounded-xl shadow-lg p-8">
      <div class="w-16 h-16 mx-auto mb-4 bg-red-100 rounded-full flex items-center justify-center">
        <svg class="w-8 h-8 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
        </svg>
      </div>

      <h1 class="text-4xl font-bold text-gray-800 mb-2"><%= statusCode %></h1>
      <p class="text-gray-600 mb-6"><%= message %></p>

      <% if (stack) { %>
        <details class="text-left mb-6">
          <summary class="text-sm text-gray-500 cursor-pointer hover:text-gray-700">Stack Trace</summary>
          <pre class="mt-2 p-4 bg-gray-900 text-gray-100 rounded-lg text-xs overflow-x-auto"><%= stack %></pre>
        </details>
      <% } %>

      <div class="flex gap-3 justify-center">
        <a href="javascript:history.back()" class="px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 font-medium rounded-lg transition-colors">
          Go Back
        </a>
        <a href="/dashboard" class="px-4 py-2 bg-gray-800 hover:bg-gray-700 text-white font-medium rounded-lg transition-colors">
          Dashboard
        </a>
      </div>
    </div>
  </div>
</body>
</html>

<%#
  Empty State Component
  Props:
    - title: string
    - message: string (optional)
    - icon: string (optional, SVG path)
    - actionText: string (optional)
    - actionHref: string (optional)
%>
<div class="text-center py-12">
  <% if (typeof icon !== 'undefined' && icon) { %>
    <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="<%= icon %>"/>
    </svg>
  <% } else { %>
    <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"/>
    </svg>
  <% } %>
  <h3 class="mt-4 text-lg font-medium text-gray-900"><%= title %></h3>
  <% if (typeof message !== 'undefined' && message) { %>
    <p class="mt-2 text-sm text-gray-500"><%= message %></p>
  <% } %>
  <% if (typeof actionText !== 'undefined' && actionText && typeof actionHref !== 'undefined' && actionHref) { %>
    <div class="mt-6">
      <a href="<%= actionHref %>" class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-blue-600 hover:bg-blue-700">
        <%= actionText %>
      </a>
    </div>
  <% } %>
</div>

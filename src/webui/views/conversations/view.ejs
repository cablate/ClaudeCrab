<%- include('../partials/start', { title }) %>

<!-- Back Button -->
<a href="/sessions/<%= sessionId %>" class="inline-flex items-center gap-2 text-gray-600 hover:text-gray-900 mb-6">
  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
  </svg>
  Back to Session
</a>

<!-- Session Info Bar -->
<% if (session) { %>
<div class="bg-white rounded-lg shadow-sm border border-gray-200 p-4 mb-6">
  <div class="flex flex-wrap items-center gap-6 text-sm">
    <div>
      <span class="text-gray-500">Platform:</span>
      <span class="ml-1 font-medium capitalize"><%= session.platform %></span>
    </div>
    <div>
      <span class="text-gray-500">User:</span>
      <span class="ml-1 font-mono"><%= session.userId %></span>
    </div>
    <div>
      <span class="text-gray-500">Agent:</span>
      <a href="/agents/<%= session.agentId %>" class="ml-1 text-blue-600 hover:text-blue-800"><%= session.agentName %></a>
    </div>
    <div>
      <span class="text-gray-500">Messages:</span>
      <span class="ml-1 font-medium"><%= messageCount %></span>
    </div>
  </div>
</div>
<% } %>

<!-- Conversation -->
<div class="bg-white rounded-lg shadow-sm border border-gray-200">
  <div class="px-6 py-4 border-b border-gray-200">
    <h3 class="text-lg font-semibold text-gray-800">Conversation History</h3>
  </div>

  <% if (conversations.length === 0) { %>
    <div class="p-6">
      <%- include('../components/empty-state', {
        title: 'No messages',
        message: 'This conversation has no messages yet'
      }) %>
    </div>
  <% } else { %>
    <div class="p-6 space-y-6">
      <% conversations.forEach((msg, index) => { %>
        <div class="flex gap-4 <%= msg.role === 'assistant' ? 'bg-gray-50 -mx-6 px-6 py-4' : '' %>">
          <!-- Avatar -->
          <div class="flex-shrink-0">
            <div class="w-10 h-10 rounded-full flex items-center justify-center <%= msg.role === 'user' ? 'bg-blue-100' : 'bg-gray-200' %>">
              <% if (msg.role === 'user') { %>
                <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                </svg>
              <% } else { %>
                <svg class="w-5 h-5 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
                </svg>
              <% } %>
            </div>
          </div>

          <!-- Message Content -->
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-2 mb-1">
              <span class="font-medium text-gray-900"><%= msg.role === 'user' ? 'User' : 'Assistant' %></span>
              <span class="text-xs text-gray-400">
                <%= new Date(msg.createdAt).toLocaleString('zh-TW') %>
              </span>
              <span class="text-xs text-gray-400">#<%= msg.sequenceNumber %></span>
            </div>
            <div class="prose prose-sm max-w-none">
              <pre class="whitespace-pre-wrap text-gray-700 font-sans text-sm"><%= msg.content %></pre>
            </div>
          </div>
        </div>

        <% if (index < conversations.length - 1) { %>
          <hr class="border-gray-200">
        <% } %>
      <% }) %>
    </div>
  <% } %>
</div>

<!-- Export Options -->
<% if (conversations.length > 0) { %>
<div class="mt-6 flex justify-end gap-3">
  <button
    onclick="exportConversation('json')"
    class="px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 font-medium rounded-lg text-sm transition-colors"
  >
    Export JSON
  </button>
  <button
    onclick="exportConversation('markdown')"
    class="px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 font-medium rounded-lg text-sm transition-colors"
  >
    Export Markdown
  </button>
</div>
<% } %>

<script>
function exportConversation(format) {
  const conversations = <%- JSON.stringify(conversations) %>;
  const sessionId = '<%= sessionId %>';

  let content, filename, mimeType;

  if (format === 'json') {
    content = JSON.stringify(conversations, null, 2);
    filename = `conversation-${sessionId.slice(0, 8)}.json`;
    mimeType = 'application/json';
  } else {
    content = conversations.map(msg =>
      `## ${msg.role === 'user' ? 'User' : 'Assistant'}\n\n${msg.content}\n\n---\n`
    ).join('\n');
    filename = `conversation-${sessionId.slice(0, 8)}.md`;
    mimeType = 'text/markdown';
  }

  const blob = new Blob([content], { type: mimeType });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = filename;
  a.click();
  URL.revokeObjectURL(url);
}
</script>

<%- include('../partials/end') %>

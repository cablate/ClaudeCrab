<%- include('../partials/start', { title }) %>

<!-- Header -->
<div class="flex items-center justify-between mb-6">
  <div class="flex items-center gap-4">
    <a href="/system" class="text-gray-400 hover:text-gray-600">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
      </svg>
    </a>
    <h1 class="text-2xl font-bold text-gray-800">System Metrics</h1>
  </div>
  <button onclick="location.reload()" class="px-4 py-2 text-sm text-gray-600 hover:text-gray-800 border border-gray-300 rounded-lg hover:bg-gray-50">
    Refresh
  </button>
</div>

<% if (metrics === null) { %>
  <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-4">
    <p class="text-yellow-800">Monitoring service not available</p>
  </div>
<% } else { %>

<!-- Memory Section -->
<div class="bg-white rounded-lg shadow-sm border border-gray-200 mb-6">
  <div class="px-6 py-4 border-b border-gray-200">
    <h3 class="text-lg font-semibold text-gray-800">Memory Usage</h3>
  </div>
  <div class="p-6">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      <div>
        <p class="text-sm text-gray-500">Heap Used</p>
        <p class="text-2xl font-bold text-gray-900"><%= formatBytes(metrics.memory.heapUsed) %></p>
        <div class="mt-2 h-2 bg-gray-200 rounded-full overflow-hidden">
          <div class="h-full bg-blue-500 rounded-full" style="width: <%= Math.round(metrics.memory.heapUsed / metrics.memory.heapTotal * 100) %>%"></div>
        </div>
        <p class="text-xs text-gray-400 mt-1"><%= Math.round(metrics.memory.heapUsed / metrics.memory.heapTotal * 100) %>% of heap</p>
      </div>
      <div>
        <p class="text-sm text-gray-500">Heap Total</p>
        <p class="text-2xl font-bold text-gray-900"><%= formatBytes(metrics.memory.heapTotal) %></p>
        <p class="text-xs text-gray-400 mt-1">Allocated heap space</p>
      </div>
      <div>
        <p class="text-sm text-gray-500">RSS</p>
        <p class="text-2xl font-bold text-gray-900"><%= formatBytes(metrics.memory.rss) %></p>
        <p class="text-xs text-gray-400 mt-1">Resident Set Size</p>
      </div>
      <div>
        <p class="text-sm text-gray-500">External</p>
        <p class="text-2xl font-bold text-gray-900"><%= formatBytes(metrics.memory.external) %></p>
        <p class="text-xs text-gray-400 mt-1">C++ objects bound to JS</p>
      </div>
    </div>
  </div>
</div>

<!-- Process Section -->
<div class="bg-white rounded-lg shadow-sm border border-gray-200 mb-6">
  <div class="px-6 py-4 border-b border-gray-200">
    <h3 class="text-lg font-semibold text-gray-800">Process Information</h3>
  </div>
  <div class="p-6">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div>
        <p class="text-sm text-gray-500">Uptime</p>
        <p class="text-2xl font-bold text-gray-900"><%= metrics.uptimeFormatted %></p>
        <p class="text-xs text-gray-400 mt-1"><%= Math.floor(metrics.uptime / 1000) %> seconds</p>
      </div>
      <div>
        <p class="text-sm text-gray-500">Node.js Version</p>
        <p class="text-2xl font-bold text-gray-900"><%= process.version %></p>
        <p class="text-xs text-gray-400 mt-1"><%= process.platform %> <%= process.arch %></p>
      </div>
      <div>
        <p class="text-sm text-gray-500">PID</p>
        <p class="text-2xl font-bold text-gray-900"><%= process.pid %></p>
        <p class="text-xs text-gray-400 mt-1">Process ID</p>
      </div>
    </div>
  </div>
</div>

<!-- Sessions Section -->
<div class="bg-white rounded-lg shadow-sm border border-gray-200">
  <div class="px-6 py-4 border-b border-gray-200">
    <h3 class="text-lg font-semibold text-gray-800">Session Metrics</h3>
  </div>
  <div class="p-6">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div>
        <p class="text-sm text-gray-500">Active Sessions</p>
        <p class="text-2xl font-bold text-gray-900"><%= metrics.activeSessions %></p>
      </div>
      <div>
        <p class="text-sm text-gray-500">Processing</p>
        <p class="text-2xl font-bold text-<%= metrics.processingSessions > 0 ? 'yellow' : 'gray' %>-<%= metrics.processingSessions > 0 ? '600' : '900' %>"><%= metrics.processingSessions %></p>
        <p class="text-xs text-gray-400 mt-1">Currently handling queries</p>
      </div>
      <div>
        <p class="text-sm text-gray-500">Bots Running</p>
        <p class="text-2xl font-bold text-green-600"><%= metrics.botsRunning %></p>
        <p class="text-xs text-gray-400 mt-1">of <%= metrics.botStatus.length %> configured</p>
      </div>
    </div>
  </div>
</div>

<% } %>

<%- include('../partials/end') %>

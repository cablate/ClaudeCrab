<%- include('../partials/start', { title }) %>

<!-- System Overview Header -->
<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-bold text-gray-800">System Overview</h1>
  <button onclick="location.reload()" class="px-4 py-2 text-sm text-gray-600 hover:text-gray-800 border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors">
    <span class="inline-flex items-center gap-2">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
      </svg>
      Refresh
    </span>
  </button>
</div>

<% if (metrics === null) { %>
  <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-4 mb-6">
    <p class="text-yellow-800">Monitoring service not available</p>
  </div>
<% } else { %>

<!-- Stats Cards -->
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
  <!-- Uptime -->
  <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-sm font-medium text-gray-500">Uptime</p>
        <p class="text-2xl font-bold text-gray-900 mt-1"><%= metrics.uptimeFormatted %></p>
      </div>
      <div class="w-12 h-12 bg-green-100 rounded-lg flex items-center justify-center">
        <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
      </div>
    </div>
  </div>

  <!-- Memory -->
  <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-sm font-medium text-gray-500">Memory (Heap)</p>
        <p class="text-2xl font-bold text-gray-900 mt-1"><%= formatBytes(metrics.memory.heapUsed) %></p>
        <p class="text-xs text-gray-400">/ <%= formatBytes(metrics.memory.heapTotal) %></p>
      </div>
      <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center">
        <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z"/>
        </svg>
      </div>
    </div>
  </div>

  <!-- Active Sessions -->
  <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-sm font-medium text-gray-500">Active Sessions</p>
        <p class="text-2xl font-bold text-gray-900 mt-1"><%= metrics.activeSessions %></p>
        <p class="text-xs text-gray-400"><%= metrics.processingSessions %> processing</p>
      </div>
      <div class="w-12 h-12 bg-purple-100 rounded-lg flex items-center justify-center">
        <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
        </svg>
      </div>
    </div>
  </div>

  <!-- Bots Status -->
  <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-sm font-medium text-gray-500">Bots Running</p>
        <p class="text-2xl font-bold text-gray-900 mt-1"><%= metrics.botsRunning %> / <%= metrics.botStatus.length %></p>
        <p class="text-xs text-gray-400">
          <% if (metrics.botsError > 0) { %>
            <span class="text-red-500"><%= metrics.botsError %> error</span>
          <% } else { %>
            <%= metrics.botsStopped %> stopped
          <% } %>
        </p>
      </div>
      <div class="w-12 h-12 bg-<%= metrics.botsError > 0 ? 'red' : 'green' %>-100 rounded-lg flex items-center justify-center">
        <svg class="w-6 h-6 text-<%= metrics.botsError > 0 ? 'red' : 'green' %>-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
        </svg>
      </div>
    </div>
  </div>
</div>

<!-- Two Column Layout -->
<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
  <!-- Bot Status -->
  <div class="bg-white rounded-lg shadow-sm border border-gray-200">
    <div class="px-6 py-4 border-b border-gray-200 flex items-center justify-between">
      <h3 class="text-lg font-semibold text-gray-800">Bot Status</h3>
      <a href="/agents" class="text-sm text-blue-600 hover:text-blue-700">Manage &rarr;</a>
    </div>
    <div class="divide-y divide-gray-200">
      <% if (metrics.botStatus.length === 0) { %>
        <div class="p-6 text-center text-gray-500">No agents configured</div>
      <% } else { %>
        <% metrics.botStatus.forEach(bot => { %>
          <div class="px-6 py-3 flex items-center justify-between">
            <div class="flex items-center gap-3">
              <% if (bot.status === 'running') { %>
                <span class="w-2 h-2 bg-green-500 rounded-full"></span>
              <% } else if (bot.status === 'error') { %>
                <span class="w-2 h-2 bg-red-500 rounded-full"></span>
              <% } else if (bot.status === 'stopped') { %>
                <span class="w-2 h-2 bg-gray-400 rounded-full"></span>
              <% } else { %>
                <span class="w-2 h-2 bg-gray-300 rounded-full"></span>
              <% } %>
              <div>
                <p class="font-medium text-gray-900"><%= bot.agentName %></p>
                <p class="text-xs text-gray-500"><%= bot.platform %></p>
              </div>
            </div>
            <span class="px-2 py-1 text-xs font-medium rounded-full
              <% if (bot.status === 'running') { %>bg-green-100 text-green-800
              <% } else if (bot.status === 'error') { %>bg-red-100 text-red-800
              <% } else if (bot.status === 'stopped') { %>bg-gray-100 text-gray-600
              <% } else { %>bg-gray-50 text-gray-400<% } %>">
              <%= bot.status %>
            </span>
          </div>
        <% }) %>
      <% } %>
    </div>
  </div>

  <!-- Recent Events -->
  <div class="bg-white rounded-lg shadow-sm border border-gray-200">
    <div class="px-6 py-4 border-b border-gray-200 flex items-center justify-between">
      <h3 class="text-lg font-semibold text-gray-800">Recent Events</h3>
      <a href="/system/events" class="text-sm text-blue-600 hover:text-blue-700">View All &rarr;</a>
    </div>
    <div class="divide-y divide-gray-200 max-h-80 overflow-y-auto">
      <% if (events.length === 0) { %>
        <div class="p-6 text-center text-gray-500">No recent events</div>
      <% } else { %>
        <% events.forEach(event => { %>
          <div class="px-6 py-3">
            <div class="flex items-center justify-between">
              <span class="text-xs font-medium px-2 py-0.5 rounded bg-gray-100 text-gray-600"><%= event.type %></span>
              <span class="text-xs text-gray-400"><%= new Date(event.timestamp).toLocaleTimeString('zh-TW') %></span>
            </div>
            <p class="text-sm text-gray-700 mt-1 truncate"><%= event.summary %></p>
          </div>
        <% }) %>
      <% } %>
    </div>
  </div>
</div>

<!-- Quick Links -->
<div class="mt-6 grid grid-cols-1 md:grid-cols-3 gap-4">
  <a href="/system/metrics" class="block p-4 bg-white rounded-lg shadow-sm border border-gray-200 hover:border-blue-300 transition-colors">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 bg-blue-100 rounded-lg flex items-center justify-center">
        <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
        </svg>
      </div>
      <div>
        <p class="font-medium text-gray-900">Detailed Metrics</p>
        <p class="text-sm text-gray-500">Memory, CPU, performance</p>
      </div>
    </div>
  </a>
  <a href="/system/events" class="block p-4 bg-white rounded-lg shadow-sm border border-gray-200 hover:border-blue-300 transition-colors">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 bg-purple-100 rounded-lg flex items-center justify-center">
        <svg class="w-5 h-5 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
        </svg>
      </div>
      <div>
        <p class="font-medium text-gray-900">Event Log</p>
        <p class="text-sm text-gray-500">System events history</p>
      </div>
    </div>
  </a>
  <a href="/system/audit" class="block p-4 bg-white rounded-lg shadow-sm border border-gray-200 hover:border-blue-300 transition-colors">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 bg-yellow-100 rounded-lg flex items-center justify-center">
        <svg class="w-5 h-5 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
        </svg>
      </div>
      <div>
        <p class="font-medium text-gray-900">Audit Log</p>
        <p class="text-sm text-gray-500">Security & operations</p>
      </div>
    </div>
  </a>
</div>

<% } %>

<%- include('../partials/end') %>

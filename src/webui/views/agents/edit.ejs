<%- include('../partials/start', { title }) %>

<!-- Back Button -->
<a href="/agents/<%= agent.id %>" class="inline-flex items-center gap-2 text-gray-600 hover:text-gray-900 mb-6">
  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
  </svg>
  返回 Agent
</a>

<!-- Edit Agent Form -->
<div class="max-w-3xl mx-auto">
  <div class="bg-white rounded-lg shadow-sm border border-gray-200">
    <div class="px-6 py-4 border-b border-gray-200">
      <h2 class="text-lg font-medium text-gray-900">編輯 Agent</h2>
      <p class="text-sm text-gray-500 mt-1">修改 Agent 設定。Agent ID 建立後無法更改。</p>
    </div>

    <!-- Tab Navigation -->
    <div class="border-b border-gray-200">
      <nav class="flex -mb-px px-6" id="tabNav">
        <button type="button" data-tab="basic" class="tab-btn px-4 py-3 text-sm font-medium border-b-2 border-blue-500 text-blue-600">基本</button>
        <button type="button" data-tab="model" class="tab-btn px-4 py-3 text-sm font-medium border-b-2 border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300">模型參數</button>
        <button type="button" data-tab="tools" class="tab-btn px-4 py-3 text-sm font-medium border-b-2 border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300">工具</button>
        <button type="button" data-tab="group" class="tab-btn px-4 py-3 text-sm font-medium border-b-2 border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300">群組協作</button>
      </nav>
    </div>

    <form id="editAgentForm" class="p-6">

      <!-- ========== Tab: 基本 ========== -->
      <div id="tab-basic" class="tab-panel space-y-6">
        <!-- Agent ID (Read-only) -->
        <div>
          <label class="block text-sm font-medium text-gray-700">Agent ID</label>
          <input type="text" value="<%= agent.id %>" disabled
            class="mt-1 block w-full px-3 py-2 border border-gray-200 rounded-md bg-gray-50 text-gray-500 sm:text-sm">
          <p class="mt-1 text-xs text-gray-500">建立後無法更改。</p>
        </div>

        <!-- Name -->
        <div>
          <label for="agentName" class="block text-sm font-medium text-gray-700">顯示名稱 *</label>
          <input type="text" id="agentName" name="name" required value="<%= agent.name %>"
            class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 sm:text-sm">
        </div>

        <!-- Description -->
        <div>
          <label for="agentDescription" class="block text-sm font-medium text-gray-700">描述</label>
          <textarea id="agentDescription" name="description" rows="2"
            class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 sm:text-sm"><%= agent.description %></textarea>
          <p class="mt-1 text-xs text-gray-500">群組中其他 Bot 會看到此描述，用於判斷是否需要協作。</p>
        </div>

        <!-- Model -->
        <div>
          <label for="agentModel" class="block text-sm font-medium text-gray-700">模型 *</label>
          <select id="agentModel" name="model" required
            class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 sm:text-sm">
            <option value="sonnet" <%= agent.model === 'sonnet' ? 'selected' : '' %>>Sonnet（推薦）</option>
            <option value="opus" <%= agent.model === 'opus' ? 'selected' : '' %>>Opus</option>
            <option value="haiku" <%= agent.model === 'haiku' ? 'selected' : '' %>>Haiku</option>
          </select>
        </div>

        <!-- Telegram Bot Token -->
        <div>
          <label for="telegramToken" class="block text-sm font-medium text-gray-700">Telegram Bot Token</label>
          <input type="text" id="telegramToken" name="telegramBotToken" value="<%= agent.telegramBotToken %>"
            placeholder="123456789:ABCdefGHIjklMNOpqrSTUvwxYZ"
            class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 sm:text-sm">
          <p class="mt-1 text-xs text-gray-500">從 Telegram @BotFather 取得。留空則移除。</p>
        </div>
      </div>

      <!-- ========== Tab: 模型參數 ========== -->
      <div id="tab-model" class="tab-panel space-y-6 hidden">
        <p class="text-sm text-gray-500">控制 SDK 查詢行為。留空使用預設值。</p>

        <div class="grid grid-cols-2 gap-6">
          <!-- maxTokens -->
          <div>
            <label for="maxTokens" class="block text-sm font-medium text-gray-700">最大輸出 Token</label>
            <input type="number" id="maxTokens" name="maxTokens" min="1" value="<%= agent.maxTokens %>"
              placeholder="依模型預設"
              class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 sm:text-sm">
            <p class="mt-1 text-xs text-gray-500">每次回覆的最大輸出 token 數。</p>
          </div>

          <!-- maxThinkingTokens -->
          <div>
            <label for="maxThinkingTokens" class="block text-sm font-medium text-gray-700">最大思考 Token</label>
            <input type="number" id="maxThinkingTokens" name="maxThinkingTokens" min="1" value="<%= agent.maxThinkingTokens %>"
              placeholder="依模型預設"
              class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 sm:text-sm">
            <p class="mt-1 text-xs text-gray-500">extended thinking 的最大 token 數。</p>
          </div>

          <!-- maxTurns -->
          <div>
            <label for="maxTurns" class="block text-sm font-medium text-gray-700">最大回合數</label>
            <input type="number" id="maxTurns" name="maxTurns" min="1" value="<%= agent.settings.maxTurns %>"
              placeholder="不限"
              class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 sm:text-sm">
            <p class="mt-1 text-xs text-gray-500">每次查詢的最大 agentic 回合數（tool call 循環次數）。</p>
          </div>

          <!-- permissionMode -->
          <div>
            <label for="permissionMode" class="block text-sm font-medium text-gray-700">權限模式</label>
            <select id="permissionMode" name="permissionMode"
              class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 sm:text-sm">
              <option value="" <%= !agent.settings.permissionMode ? 'selected' : '' %>>預設</option>
              <option value="default" <%= agent.settings.permissionMode === 'default' ? 'selected' : '' %>>default — 每次詢問</option>
              <option value="acceptEdits" <%= agent.settings.permissionMode === 'acceptEdits' ? 'selected' : '' %>>acceptEdits — 自動接受編輯</option>
              <option value="bypassPermissions" <%= agent.settings.permissionMode === 'bypassPermissions' ? 'selected' : '' %>>bypassPermissions — 跳過所有權限</option>
              <option value="plan" <%= agent.settings.permissionMode === 'plan' ? 'selected' : '' %>>plan — 僅規劃不執行</option>
              <option value="delegate" <%= agent.settings.permissionMode === 'delegate' ? 'selected' : '' %>>delegate — 委託模式</option>
              <option value="dontAsk" <%= agent.settings.permissionMode === 'dontAsk' ? 'selected' : '' %>>dontAsk — 不問直接跳過</option>
            </select>
            <p class="mt-1 text-xs text-gray-500">Agent 遇到需要權限的操作時的處理方式。</p>
          </div>
        </div>
      </div>

      <!-- ========== Tab: 工具 ========== -->
      <div id="tab-tools" class="tab-panel space-y-6 hidden">
        <!-- permissions.allow (settings.local.json — SDK auto-approve) -->
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">自動核准工具</label>
          <p class="text-xs text-gray-500 mb-3">SDK 執行時自動核准的工具清單（<code class="text-xs bg-gray-100 px-1 rounded">settings.local.json</code>）。Agent 使用工具時不會再詢問確認。</p>

          <!-- Tag list -->
          <div id="permTagList" class="flex flex-wrap gap-2 mb-3 min-h-[36px] p-2 bg-gray-50 rounded-md border border-gray-200">
            <% permissions.allow.forEach(function(tool) { %>
              <span class="perm-tag inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                <span class="perm-tag-name"><%= tool %></span>
                <button type="button" onclick="removePermTag(this)" class="ml-0.5 inline-flex items-center justify-center w-4 h-4 rounded-full hover:bg-blue-200 text-blue-600 hover:text-blue-800 transition-colors">&times;</button>
              </span>
            <% }); %>
          </div>

          <!-- Add input -->
          <div class="flex gap-2">
            <input type="text" id="permAddInput" placeholder="輸入工具名稱後按 Enter 或點新增"
              class="flex-1 px-3 py-1.5 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 sm:text-sm font-mono"
              onkeydown="if(event.key==='Enter'){event.preventDefault();addPermTag();}">
            <button type="button" onclick="addPermTag()" class="px-3 py-1.5 text-sm font-medium text-blue-700 bg-blue-50 border border-blue-200 rounded-md hover:bg-blue-100 transition-colors">新增</button>
          </div>
        </div>

        <hr class="border-gray-200">

        <!-- mcpConfigFile -->
        <div>
          <label for="mcpConfigFile" class="block text-sm font-medium text-gray-700">MCP 設定檔路徑</label>
          <input type="text" id="mcpConfigFile" name="mcpConfigFile" value="<%= agent.mcpConfigFile %>"
            placeholder="預設: mcp-servers.json"
            class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 sm:text-sm">
          <p class="mt-1 text-xs text-gray-500">MCP 伺服器設定檔（相對於 Agent 目錄）。Agent 啟動時載入。</p>
        </div>
      </div>

      <!-- ========== Tab: 群組協作 ========== -->
      <div id="tab-group" class="tab-panel space-y-6 hidden">
        <!-- Delegation Section -->
        <div>
          <h3 class="text-sm font-medium text-gray-900 mb-3">自動委派</h3>
          <p class="text-xs text-gray-500 mb-4">控制此 Agent 在群組中被 @mention 時的自動委派行為。</p>

          <div class="space-y-3">
            <label class="flex items-center justify-between p-3 bg-gray-50 rounded-md">
              <div>
                <span class="text-sm font-medium text-gray-700">接受入站委派</span>
                <p class="text-xs text-gray-500">其他 Bot 的回覆中 @mention 此 Agent 時，自動觸發回應。</p>
              </div>
              <input type="checkbox" id="delegationInbound" name="delegationInbound"
                <%= agent.settings.delegation.inbound ? 'checked' : '' %>
                class="h-4 w-4 rounded border-gray-300 text-blue-600 focus:ring-2 focus:ring-blue-500 focus:ring-offset-0">
            </label>

            <label class="flex items-center justify-between p-3 bg-gray-50 rounded-md">
              <div>
                <span class="text-sm font-medium text-gray-700">允許出站委派</span>
                <p class="text-xs text-gray-500">此 Agent 的回覆中 @mention 其他 Bot 時，自動觸發對方回應。</p>
              </div>
              <input type="checkbox" id="delegationOutbound" name="delegationOutbound"
                <%= agent.settings.delegation.outbound ? 'checked' : '' %>
                class="h-4 w-4 rounded border-gray-300 text-blue-600 focus:ring-2 focus:ring-blue-500 focus:ring-offset-0">
            </label>
          </div>
        </div>

        <!-- Initiative Section -->
        <div>
          <h3 class="text-sm font-medium text-gray-900 mb-3">主動回應</h3>
          <p class="text-xs text-gray-500 mb-4">控制此 Agent 是否能在未被 @mention 的情況下主動加入群組對話。</p>

          <div class="space-y-4">
            <label class="flex items-center justify-between p-3 bg-gray-50 rounded-md">
              <div>
                <span class="text-sm font-medium text-gray-700">啟用主動回應</span>
                <p class="text-xs text-gray-500">根據 Agent 描述與訊息內容，由 LLM 判斷是否主動回覆。</p>
              </div>
              <input type="checkbox" id="initiativeEnabled" name="initiativeEnabled"
                <%= agent.settings.initiative.enabled ? 'checked' : '' %>
                class="h-4 w-4 rounded border-gray-300 text-blue-600 focus:ring-2 focus:ring-blue-500 focus:ring-offset-0"
                onchange="toggleInitiativeFields()">
            </label>

            <div id="initiativeFields" class="<%= agent.settings.initiative.enabled ? '' : 'hidden' %> space-y-4 pl-4 border-l-2 border-blue-200">
              <!-- mode -->
              <div>
                <label for="initiativeMode" class="block text-sm font-medium text-gray-700">評估模式</label>
                <select id="initiativeMode" name="initiativeMode"
                  class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 sm:text-sm">
                  <option value="work" <%= agent.settings.initiative.mode === 'work' ? 'selected' : '' %>>work — 僅工作相關話題</option>
                  <option value="social" <%= agent.settings.initiative.mode === 'social' ? 'selected' : '' %>>social — 僅閒聊話題</option>
                  <option value="full" <%= agent.settings.initiative.mode === 'full' ? 'selected' : '' %>>full — 所有話題</option>
                </select>
                <p class="mt-1 text-xs text-gray-500">決定 LLM 評估時使用的判斷標準。</p>
              </div>

              <div class="grid grid-cols-2 gap-4">
                <!-- cooldown -->
                <div>
                  <label for="initiativeCooldown" class="block text-sm font-medium text-gray-700">冷卻時間（秒）</label>
                  <input type="number" id="initiativeCooldown" name="initiativeCooldown" min="0"
                    value="<%= agent.settings.initiative.cooldown %>"
                    class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 sm:text-sm">
                  <p class="mt-1 text-xs text-gray-500">兩次主動回應之間的最短間隔。</p>
                </div>

                <!-- maxPerHour -->
                <div>
                  <label for="initiativeMaxPerHour" class="block text-sm font-medium text-gray-700">每小時上限</label>
                  <input type="number" id="initiativeMaxPerHour" name="initiativeMaxPerHour" min="1"
                    value="<%= agent.settings.initiative.maxPerHour %>"
                    class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 sm:text-sm">
                  <p class="mt-1 text-xs text-gray-500">每個群組每小時最多主動回應次數。</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Error message -->
      <div id="errorMessage" class="hidden mt-6 p-4 bg-red-50 border border-red-200 rounded-md">
        <p class="text-sm text-red-700"></p>
      </div>

      <!-- Success message -->
      <div id="successMessage" class="hidden mt-6 p-4 bg-green-50 border border-green-200 rounded-md">
        <p class="text-sm text-green-700"></p>
      </div>

      <!-- Actions -->
      <div class="flex items-center justify-end gap-3 pt-6 mt-6 border-t border-gray-200">
        <a href="/agents/<%= agent.id %>" class="px-4 py-2 text-sm font-medium text-gray-700 hover:text-gray-900">
          取消
        </a>
        <button type="submit"
          class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 disabled:opacity-50 disabled:cursor-not-allowed">
          <span id="submitText">儲存變更</span>
          <svg id="submitSpinner" class="hidden animate-spin ml-2 h-4 w-4 text-white" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
        </button>
      </div>
    </form>
  </div>
</div>

<script>
// Tab switching
function switchTab(tabName) {
  document.querySelectorAll('.tab-panel').forEach(p => p.classList.add('hidden'));
  document.querySelectorAll('.tab-btn').forEach(b => {
    b.classList.remove('border-blue-500', 'text-blue-600');
    b.classList.add('border-transparent', 'text-gray-500');
  });
  const panel = document.getElementById('tab-' + tabName);
  const btn = document.querySelector('[data-tab="' + tabName + '"]');
  if (panel) panel.classList.remove('hidden');
  if (btn) {
    btn.classList.add('border-blue-500', 'text-blue-600');
    btn.classList.remove('border-transparent', 'text-gray-500');
  }
}

document.querySelectorAll('.tab-btn').forEach(btn => {
  btn.addEventListener('click', () => switchTab(btn.dataset.tab));
});

// === Permission tag helpers ===
function removePermTag(btn) {
  btn.closest('.perm-tag').remove();
}

function addPermTag() {
  const input = document.getElementById('permAddInput');
  const name = input.value.trim();
  if (!name) return;
  // Prevent duplicates
  const existing = [...document.querySelectorAll('.perm-tag-name')].map(el => el.textContent);
  if (existing.includes(name)) { input.value = ''; return; }
  const tag = document.createElement('span');
  tag.className = 'perm-tag inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-medium bg-blue-100 text-blue-800';
  tag.innerHTML = '<span class="perm-tag-name">' + name + '</span>' +
    '<button type="button" onclick="removePermTag(this)" class="ml-0.5 inline-flex items-center justify-center w-4 h-4 rounded-full hover:bg-blue-200 text-blue-600 hover:text-blue-800 transition-colors">&times;</button>';
  document.getElementById('permTagList').appendChild(tag);
  input.value = '';
  input.focus();
}

function getPermTags() {
  return [...document.querySelectorAll('.perm-tag-name')].map(el => el.textContent);
}

// Initiative fields toggle
function toggleInitiativeFields() {
  const enabled = document.getElementById('initiativeEnabled').checked;
  const fields = document.getElementById('initiativeFields');
  if (enabled) {
    fields.classList.remove('hidden');
  } else {
    fields.classList.add('hidden');
  }
}

// Parse comma-separated string to array (filtering empty)
function parseCommaSeparated(value) {
  if (!value || !value.trim()) return null;
  return value.split(',').map(s => s.trim()).filter(Boolean);
}

// Parse number input (empty string → null to remove)
function parseNumberOrNull(value) {
  if (value === '' || value === undefined || value === null) return null;
  const num = Number(value);
  return isNaN(num) ? null : num;
}

// Form submission
document.getElementById('editAgentForm').addEventListener('submit', async (e) => {
  e.preventDefault();

  const form = e.target;
  const submitBtn = form.querySelector('button[type="submit"]');
  const submitText = document.getElementById('submitText');
  const submitSpinner = document.getElementById('submitSpinner');
  const errorDiv = document.getElementById('errorMessage');
  const successDiv = document.getElementById('successMessage');

  submitBtn.disabled = true;
  submitText.textContent = '儲存中...';
  submitSpinner.classList.remove('hidden');
  errorDiv.classList.add('hidden');
  successDiv.classList.add('hidden');

  const formData = new FormData(form);

  // === 基本 tab ===
  const payload = {
    name: formData.get('name'),
    description: formData.get('description'),
    model: formData.get('model'),
  };

  // Telegram token (null = 移除)
  const telegramToken = formData.get('telegramBotToken');
  payload.telegramBotToken = telegramToken ? telegramToken : null;

  // === 模型參數 tab ===
  payload.maxTokens = parseNumberOrNull(formData.get('maxTokens'));
  payload.maxThinkingTokens = parseNumberOrNull(formData.get('maxThinkingTokens'));

  // === 工具 tab: settings.local.json 層（SDK 自動核准）===
  payload.permissions = { allow: getPermTags(), deny: [] };

  // === 工具 tab: MCP 設定 ===
  const mcpConfigFile = formData.get('mcpConfigFile');
  payload.mcpConfigFile = mcpConfigFile ? mcpConfigFile : null;

  // === 模型參數 tab: settings ===
  const permissionMode = formData.get('permissionMode');
  payload.settings = {
    permissionMode: permissionMode || null,
    maxTurns: parseNumberOrNull(formData.get('maxTurns')),
  };

  // === 群組協作 tab: delegation ===
  payload.settings.delegation = {
    inbound: document.getElementById('delegationInbound').checked,
    outbound: document.getElementById('delegationOutbound').checked,
  };

  // === 群組協作 tab: initiative ===
  const initiativeEnabled = document.getElementById('initiativeEnabled').checked;
  if (initiativeEnabled) {
    payload.settings.initiative = {
      enabled: true,
      mode: formData.get('initiativeMode'),
      cooldown: Number(formData.get('initiativeCooldown')) || 300,
      maxPerHour: Number(formData.get('initiativeMaxPerHour')) || 5,
    };
  } else {
    payload.settings.initiative = { enabled: false };
  }

  try {
    const response = await fetch('/api/agents/<%= agent.id %>', {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    });

    const data = await response.json();

    if (response.ok && data.success) {
      successDiv.querySelector('p').textContent = 'Agent 更新成功！正在跳轉...';
      successDiv.classList.remove('hidden');
      setTimeout(() => { window.location.href = '/agents/<%= agent.id %>'; }, 1000);
    } else {
      throw new Error(data.error || '更新失敗');
    }
  } catch (error) {
    errorDiv.querySelector('p').textContent = error.message;
    errorDiv.classList.remove('hidden');
    submitBtn.disabled = false;
    submitText.textContent = '儲存變更';
    submitSpinner.classList.add('hidden');
  }
});
</script>

<%- include('../partials/end') %>

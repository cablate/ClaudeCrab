async function viewScheduleHistory(scheduleId) {
  document.getElementById('historyModalTitle').textContent = `Execution History: ${scheduleId}`;
  document.getElementById('historyTableBody').innerHTML = '<tr><td colspan="4" class="px-4 py-4 text-center text-gray-500">Loading...</td></tr>';
  document.getElementById('scheduleHistoryModal').classList.remove('hidden');

  try {
    const response = await fetch(`/api/agents/<%= agent.id %>/schedules/${encodeURIComponent(scheduleId)}/history`);
    const data = await response.json();

    if (!response.ok) {
      document.getElementById('historyTableBody').innerHTML =
        `<tr><td colspan="4" class="px-4 py-4 text-center text-red-500">${data.error || 'Failed to load history'}</td></tr>`;
      return;
    }

    const history = data.history || [];
    if (history.length === 0) {
      document.getElementById('historyTableBody').innerHTML =
        '<tr><td colspan="4" class="px-4 py-4 text-center text-gray-500">No execution history</td></tr>';
      return;
    }

    document.getElementById('historyTableBody').innerHTML = history.map(exec => {
      const startTime = new Date(exec.startedAt).toLocaleString('zh-TW');
      const statusClass = exec.success ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800';
      const statusText = exec.success ? 'Success' : 'Failed';
      const duration = exec.durationMs ? `${(exec.durationMs / 1000).toFixed(1)}s` : 'N/A';
      const result = exec.success ? (exec.resultSummary || '-') : (exec.errorMessage || '-');

      return `
        <tr class="hover:bg-gray-50">
          <td class="px-4 py-2 text-sm">${startTime}</td>
          <td class="px-4 py-2">
            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium ${statusClass}">
              ${statusText}
            </span>
          </td>
          <td class="px-4 py-2 text-sm">${duration}</td>
          <td class="px-4 py-2 text-sm text-gray-500 max-w-xs truncate" title="${result}">${result}</td>
        </tr>
      `;
    }).join('');
  } catch (error) {
    document.getElementById('historyTableBody').innerHTML =
      `<tr><td colspan="4" class="px-4 py-4 text-center text-red-500">Error: ${error.message}</td></tr>`;
  }
}

function closeScheduleHistoryModal() {
  document.getElementById('scheduleHistoryModal').classList.add('hidden');
}

// Create Schedule Functions
function openCreateScheduleModal() {
  // Reset form
  document.getElementById('createScheduleForm').reset();
  document.getElementById('newScheduleEnabled').checked = true;
  document.getElementById('newScheduleTriggerType').value = 'cron';
  onTriggerTypeChange();
  document.getElementById('cronDescription').textContent = 'Every day at 09:00';
  updateYamlPreview();
  document.getElementById('createScheduleModal').classList.remove('hidden');
}

function onTriggerTypeChange() {
  const type = document.getElementById('newScheduleTriggerType').value;
  document.getElementById('triggerCronFields').classList.toggle('hidden', type !== 'cron');
  document.getElementById('triggerOnceFields').classList.toggle('hidden', type !== 'once');
  document.getElementById('triggerIntervalFields').classList.toggle('hidden', type !== 'interval');
  updateYamlPreview();
}

function closeCreateScheduleModal() {
  document.getElementById('createScheduleModal').classList.add('hidden');
}

function updateYamlPreview() {
  const id = document.getElementById('newScheduleId').value || 'schedule-id';
  const name = document.getElementById('newScheduleName').value || 'Schedule Name';
  const description = document.getElementById('newScheduleDescription').value || '';
  const triggerType = document.getElementById('newScheduleTriggerType').value;
  const timezone = document.getElementById('newScheduleTimezone').value || 'Asia/Taipei';
  const chatId = document.getElementById('newScheduleChatId').value || '-100123456789';
  const prompt = document.getElementById('newSchedulePrompt').value || 'Your prompt here';
  const enabled = document.getElementById('newScheduleEnabled').checked;

  let triggerYaml = '';
  if (triggerType === 'cron') {
    const cron = document.getElementById('newScheduleCron').value || '0 9 * * *';
    triggerYaml = `  type: cron\n  cron: "${cron}"\n  timezone: "${timezone}"`;
  } else if (triggerType === 'once') {
    const at = document.getElementById('newScheduleAt').value || '2026-02-07T09:00';
    triggerYaml = `  type: once\n  at: "${at}"\n  timezone: "${timezone}"`;
  } else {
    const minutes = document.getElementById('newScheduleIntervalMin').value || '5';
    triggerYaml = `  type: interval\n  interval: ${parseInt(minutes) * 60000}\n  timezone: "${timezone}"`;
  }

  const yaml = `id: ${id}
name: "${name}"
${description ? `description: "${description}"\n` : ''}
trigger:
${triggerYaml}

action:
  type: send_message
  chatId: "${chatId}"
  prompt: |
    ${prompt.split('\n').join('\n    ')}

metadata:
  enabled: ${enabled}`;

  document.getElementById('yamlPreview').textContent = yaml;
}

// Update cron description on input
document.getElementById('newScheduleCron')?.addEventListener('input', function(e) {
  const cron = e.target.value;
  const descriptions = {
    '0 9 * * *': 'Every day at 09:00',
    '0 0 * * *': 'Every day at midnight',
    '0 * * * *': 'Every hour',
    '*/5 * * * *': 'Every 5 minutes',
    '0 9 * * 1': 'Every Monday at 09:00',
    '0 9 * * 1-5': 'Weekdays at 09:00',
    '0 9,18 * * *': 'Every day at 09:00 and 18:00',
  };
  document.getElementById('cronDescription').textContent = descriptions[cron] || 'Custom schedule';
  updateYamlPreview();
});

// Update preview on any form change
['newScheduleId', 'newScheduleName', 'newScheduleDescription', 'newScheduleTimezone', 
 'newScheduleChatId', 'newSchedulePrompt', 'newScheduleEnabled', 'newScheduleAt',
 'newScheduleIntervalMin', 'newScheduleTriggerType'].forEach(id => {
  const el = document.getElementById(id);
  if (el) {
    el.addEventListener('input', updateYamlPreview);
    el.addEventListener('change', updateYamlPreview);
  }
});

async function createSchedule() {
  const id = document.getElementById('newScheduleId').value.trim();
  const name = document.getElementById('newScheduleName').value.trim();
  const description = document.getElementById('newScheduleDescription').value.trim();
  const triggerType = document.getElementById('newScheduleTriggerType').value;
  const timezone = document.getElementById('newScheduleTimezone').value;
  const chatId = document.getElementById('newScheduleChatId').value.trim();
  const prompt = document.getElementById('newSchedulePrompt').value.trim();
  const enabled = document.getElementById('newScheduleEnabled').checked;

  // Basic validation
  if (!id || !name || !chatId || !prompt) {
    alert('Please fill in all required fields');
    return;
  }

  // Validate ID format
  if (!/^[a-z0-9-]+$/.test(id)) {
    alert('Schedule ID must contain only lowercase letters, numbers, and hyphens');
    return;
  }

  // Build trigger based on type
  let trigger;
  if (triggerType === 'cron') {
    const cron = document.getElementById('newScheduleCron').value.trim();
    if (!cron) { alert('Please enter a cron expression'); return; }
    trigger = { type: 'cron', cron, timezone };
  } else if (triggerType === 'once') {
    const at = document.getElementById('newScheduleAt').value;
    if (!at) { alert('Please select a date and time'); return; }
    trigger = { type: 'once', at, timezone };
  } else {
    const minutes = parseInt(document.getElementById('newScheduleIntervalMin').value);
    if (!minutes || minutes < 1) { alert('Please enter interval in minutes (minimum 1)'); return; }
    trigger = { type: 'interval', interval: minutes * 60000, timezone };
  }

  try {
    const response = await fetch('/api/agents/<%= agent.id %>/schedules', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        id,
        name,
        description: description || undefined,
        trigger,
        action: { type: 'send_message', chatId, prompt },
        enabled
      })
    });
    const data = await response.json();

    if (data.success) {
      closeCreateScheduleModal();
      schedulesLoaded = false;
      loadSchedules();
      alert(`Schedule "${name}" created successfully!`);
    } else {
      alert('Failed to create schedule: ' + (data.error || data.details || 'Unknown error'));
    }
  } catch (error) {
    alert('Failed to create schedule: ' + error.message);
  }
}

async function deleteSchedule(scheduleId, scheduleName) {
  if (!confirm(`Delete schedule "${scheduleName}"? This cannot be undone.`)) return;

  try {
    const response = await fetch(`/api/agents/<%= agent.id %>/schedules/${encodeURIComponent(scheduleId)}`, {
      method: 'DELETE'
    });
    const data = await response.json();

    if (data.success) {
      schedulesLoaded = false;
      loadSchedules();
    } else {
      alert('Failed to delete: ' + (data.error || 'Unknown error'));
    }
  } catch (error) {
    alert('Failed to delete: ' + error.message);
  }
}
</script>


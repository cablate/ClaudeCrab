<%- include('../partials/start', { title }) %>

<!-- Back Button -->
<a href="/agents" class="inline-flex items-center gap-2 text-gray-600 hover:text-gray-900 mb-6">
  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
  </svg>
  Back to Agents
</a>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  <!-- Agent Info -->
  <div class="lg:col-span-1 space-y-6">
    <!-- Basic Info Card -->
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
      <h3 class="text-lg font-semibold text-gray-800 mb-4">Agent Info</h3>
      <dl class="space-y-4">
        <div>
          <dt class="text-sm text-gray-500">ID</dt>
          <dd class="mt-1 font-mono text-sm text-gray-900"><%= agent.id %></dd>
        </div>
        <div>
          <dt class="text-sm text-gray-500">Name</dt>
          <dd class="mt-1 font-medium text-gray-900"><%= agent.name %></dd>
        </div>
        <div>
          <dt class="text-sm text-gray-500">Description</dt>
          <dd class="mt-1 text-sm text-gray-900"><%= agent.description || 'No description' %></dd>
        </div>
        <div>
          <dt class="text-sm text-gray-500">Model</dt>
          <dd class="mt-1">
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
              <%= agent.model || 'sonnet' %>
            </span>
          </dd>
        </div>
        <div>
          <dt class="text-sm text-gray-500">Version</dt>
          <dd class="mt-1 text-sm text-gray-900">v<%= agent.version || '1.0.0' %></dd>
        </div>
        <div>
          <dt class="text-sm text-gray-500">Path</dt>
          <dd class="mt-1 font-mono text-xs text-gray-500 break-all"><%= agent.path %></dd>
        </div>
        <div>
          <dt class="text-sm text-gray-500">Bot Status</dt>
          <dd class="mt-1">
            <% if (botStatus.length === 0) { %>
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-600">
                No Bot Configured
              </span>
            <% } else { %>
              <div class="flex flex-col gap-1">
                <% botStatus.forEach(bot => { %>
                  <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-medium <%= bot.status === 'running' ? 'bg-green-100 text-green-800' : 'bg-yellow-100 text-yellow-800' %>">
                    <span class="w-1.5 h-1.5 rounded-full <%= bot.status === 'running' ? 'bg-green-500' : 'bg-yellow-500' %>"></span>
                    <%= bot.platform %> · <%= bot.status %>
                  </span>
                <% }) %>
              </div>
            <% } %>
          </dd>
        </div>
        <div>
          <dt class="text-sm text-gray-500">Telegram Token</dt>
          <dd class="mt-1">
            <% if (telegramBotToken) { %>
              <span class="font-mono text-sm text-gray-900">
                <%= telegramBotToken.slice(0, 4) %>****<%= telegramBotToken.slice(-4) %>
              </span>
              <button onclick="copyToken('<%= telegramBotToken %>')" class="ml-2 text-xs text-blue-600 hover:text-blue-800">Copy</button>
            <% } else { %>
              <span class="text-sm text-gray-500 italic">Not configured</span>
            <% } %>
          </dd>
        </div>
        <div>
          <dt class="text-sm text-gray-500">Allowed Tools</dt>
          <dd class="mt-1 flex flex-wrap gap-1">
            <% if (permissions.allow.length > 0) { %>
              <% permissions.allow.forEach(tool => { %>
                <span class="px-2 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                  <%= tool %>
                </span>
              <% }) %>
            <% } else { %>
              <span class="text-sm text-gray-500 italic">Default permissions</span>
            <% } %>
          </dd>
        </div>
      </dl>

      <div class="mt-6 pt-4 border-t border-gray-200 space-y-2">
        <a
          href="/agents/<%= agent.id %>/edit"
          class="block w-full px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg transition-colors text-center"
        >
          Edit Agent
        </a>
        <button
          onclick="reloadAgent('<%= agent.id %>')"
          class="w-full px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 font-medium rounded-lg transition-colors"
        >
          Reload Agent
        </button>
      </div>
    </div>

    <!-- Config Card -->
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
      <h3 class="text-lg font-semibold text-gray-800 mb-4">Configuration</h3>
      <pre class="bg-gray-900 text-gray-100 p-4 rounded-lg text-xs overflow-x-auto"><%= JSON.stringify(agent.config, null, 2) %></pre>
    </div>
  </div>

  <!-- Tabs Section -->
  <div class="lg:col-span-2">
    <!-- Tab Navigation -->
    <div class="border-b border-gray-200 mb-6">
      <nav class="-mb-px flex gap-4">
        <button onclick="showTab('prompt')" id="tab-prompt" class="tab-btn px-4 py-2 text-sm font-medium border-b-2 border-blue-500 text-blue-600">
          System Prompt
        </button>
        <button onclick="showTab('memory')" id="tab-memory" class="tab-btn px-4 py-2 text-sm font-medium border-b-2 border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300">
          Memory System
        </button>
        <button onclick="showTab('skills')" id="tab-skills" class="tab-btn px-4 py-2 text-sm font-medium border-b-2 border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300">
          Skills
        </button>
        <button onclick="showTab('schedules')" id="tab-schedules" class="tab-btn px-4 py-2 text-sm font-medium border-b-2 border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300">
          Schedules
        </button>
        <button onclick="showTab('sessions')" id="tab-sessions" class="tab-btn px-4 py-2 text-sm font-medium border-b-2 border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300">
          Sessions (<%= sessions.length %>)
        </button>
      </nav>
    </div>

    <!-- Tab Content: System Prompt -->
    <div id="content-prompt" class="tab-content">
      <div class="bg-white rounded-lg shadow-sm border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <div class="flex justify-between items-center">
            <h3 class="text-lg font-semibold text-gray-800">System Prompt (CLAUDE.md)</h3>
            <button onclick="openMemoryFile('CLAUDE.md')" class="px-3 py-1 text-sm text-blue-600 hover:text-blue-800 hover:bg-blue-50 rounded-lg transition-colors">
              Edit
            </button>
          </div>
        </div>
        <div class="p-6">
          <% if (agent.systemPrompt) { %>
            <pre class="bg-gray-50 border border-gray-200 p-4 rounded-lg text-sm text-gray-700 whitespace-pre-wrap max-h-96 overflow-y-auto"><%= agent.systemPrompt %></pre>
          <% } else { %>
            <p class="text-gray-500 italic">No system prompt defined</p>
          <% } %>
        </div>
      </div>
    </div>

    <!-- Tab Content: Memory System -->
    <div id="content-memory" class="tab-content hidden">
      <!-- Core Files -->
      <div class="bg-white rounded-lg shadow-sm border border-gray-200 mb-6">
        <div class="px-6 py-4 border-b border-gray-200">
          <h3 class="text-lg font-semibold text-gray-800">Core Files</h3>
        </div>
        <div class="p-6 grid grid-cols-2 gap-4" id="coreFilesGrid">
          <div class="text-center py-8 text-gray-500">Loading...</div>
        </div>
      </div>

      <!-- Daily Logs -->
      <div class="bg-white rounded-lg shadow-sm border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h3 class="text-lg font-semibold text-gray-800">Daily Logs</h3>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full" id="dailyLogsTable">
            <thead class="bg-gray-50">
              <tr>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Date</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Size</th>
                <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase">Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200">
              <tr><td colspan="3" class="px-6 py-4 text-center text-gray-500">Loading...</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- Tab Content: Skills -->
    <div id="content-skills" class="tab-content hidden">
      <div class="bg-white rounded-lg shadow-sm border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200 flex justify-between items-center">
          <h3 class="text-lg font-semibold text-gray-800">Installed Skills</h3>
          <button onclick="document.getElementById('skillUploadModal').classList.remove('hidden')" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium rounded-lg transition-colors">
            + Upload Skill
          </button>
        </div>
        <div id="skillsList" class="p-6">
          <div class="text-center py-8 text-gray-500">Loading...</div>
        </div>
      </div>
    </div>

    <!-- Tab Content: Schedules -->
    <div id="content-schedules" class="tab-content hidden">
      <div class="bg-white rounded-lg shadow-sm border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200 flex justify-between items-center">
          <h3 class="text-lg font-semibold text-gray-800">Scheduled Tasks</h3>
          <button onclick="openCreateScheduleModal()" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium rounded-lg transition-colors">
            + Create Schedule
          </button>
        </div>
        <div id="schedulesList" class="p-6">
          <div class="text-center py-8 text-gray-500">Loading...</div>
        </div>
      </div>
    </div>

    <!-- Tab Content: Sessions -->
    <div id="content-sessions" class="tab-content hidden">
      <div class="bg-white rounded-lg shadow-sm border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h3 class="text-lg font-semibold text-gray-800">Active Sessions (<%= sessions.length %>)</h3>
        </div>
        <% if (sessions.length === 0) { %>
          <div class="p-6">
            <%- include('../components/empty-state', {
              title: 'No active sessions',
              message: 'Sessions using this agent will appear here'
            }) %>
          </div>
        <% } else { %>
          <div class="overflow-x-auto">
            <table class="w-full">
              <thead class="bg-gray-50">
                <tr>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">User</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Platform</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Last Active</th>
                  <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase">Actions</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-200">
                <% sessions.forEach(session => { %>
                  <tr class="hover:bg-gray-50">
                    <td class="px-6 py-4 font-mono text-sm"><%= session.userId %></td>
                    <td class="px-6 py-4 text-sm capitalize"><%= session.platform %></td>
                    <td class="px-6 py-4">
                      <%- include('../components/status-badge', { status: session.state, size: 'sm' }) %>
                    </td>
                    <td class="px-6 py-4 text-sm text-gray-500">
                      <%= new Date(session.lastActiveAt).toLocaleString('zh-TW') %>
                    </td>
                    <td class="px-6 py-4 text-right">
                      <a href="/sessions/<%= session.sessionId %>" class="text-blue-600 hover:text-blue-800 text-sm">
                        View
                      </a>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div>

<!-- Memory Modal -->
<div id="memoryModal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
  <div id="memoryModalInner" class="bg-white rounded-lg shadow-xl w-full max-w-5xl max-h-[90vh] flex flex-col mx-4 transition-all duration-200">
    <div class="px-6 py-4 border-b flex justify-between items-center">
      <h3 id="modalTitle" class="text-lg font-semibold"></h3>
      <div class="flex items-center gap-2">
        <button onclick="toggleMemoryFullscreen()" id="fullscreenBtn" class="text-gray-400 hover:text-gray-600 text-sm px-2 py-1 rounded hover:bg-gray-100" title="Toggle fullscreen">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"/></svg>
        </button>
        <button onclick="closeMemoryModal()" class="text-gray-400 hover:text-gray-600 text-xl">&times;</button>
      </div>
    </div>
    <div class="p-6 flex-1 overflow-y-auto">
      <textarea id="memoryContent" class="w-full h-[60vh] font-mono text-sm p-4 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 resize-y"></textarea>
    </div>
    <div class="px-6 py-4 border-t flex justify-between items-center">
      <span id="modalMeta" class="text-sm text-gray-500"></span>
      <div class="flex gap-2">
        <button onclick="closeMemoryModal()" class="px-4 py-2 text-gray-700 hover:bg-gray-100 rounded-lg">Cancel</button>
        <button onclick="saveMemoryFile()" id="saveBtn" class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700">Save</button>
      </div>
    </div>
  </div>
</div>

<!-- Skill Upload Modal -->
<div id="skillUploadModal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
  <div class="bg-white rounded-lg shadow-xl w-full max-w-md mx-4">
    <div class="px-6 py-4 border-b flex justify-between items-center">
      <h3 class="text-lg font-semibold">Upload Skill</h3>
      <button onclick="closeSkillUploadModal()" class="text-gray-400 hover:text-gray-600 text-xl">&times;</button>
    </div>
    <form id="skillUploadForm" class="p-6">
      <p class="text-sm text-gray-600 mb-4">
        Upload a .zip file containing a skill folder with SKILL.md
      </p>
      <input type="file" id="skillFile" accept=".zip" class="w-full border border-gray-300 rounded-lg p-2 mb-4" required>
      <div id="uploadProgress" class="hidden mb-4">
        <div class="w-full bg-gray-200 rounded-full h-2">
          <div id="progressBar" class="bg-blue-600 h-2 rounded-full" style="width: 0%"></div>
        </div>
        <p class="text-sm text-gray-500 mt-1">Uploading...</p>
      </div>
      <div class="flex justify-end gap-2">
        <button type="button" onclick="closeSkillUploadModal()" class="px-4 py-2 text-gray-700 hover:bg-gray-100 rounded-lg">Cancel</button>
        <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700">Upload</button>
      </div>
    </form>
  </div>
</div>

<!-- Skill Edit Modal -->
<div id="skillEditModal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
  <div class="bg-white rounded-lg shadow-xl w-full max-w-3xl max-h-[90vh] flex flex-col mx-4">
    <div class="px-6 py-4 border-b flex justify-between items-center">
      <h3 id="skillModalTitle" class="text-lg font-semibold"></h3>
      <button onclick="closeSkillEditModal()" class="text-gray-400 hover:text-gray-600 text-xl">&times;</button>
    </div>
    <div class="p-6 flex-1 overflow-y-auto">
      <textarea id="skillContent" class="w-full h-96 font-mono text-sm p-4 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"></textarea>
    </div>
    <div class="px-6 py-4 border-t flex justify-between items-center">
      <span id="skillModalMeta" class="text-sm text-gray-500"></span>
      <div class="flex gap-2">
        <button onclick="closeSkillEditModal()" class="px-4 py-2 text-gray-700 hover:bg-gray-100 rounded-lg">Cancel</button>
        <button onclick="saveSkill()" class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700">Save</button>
      </div>
    </div>
  </div>
</div>

<!-- Schedule Edit Modal -->
<div id="scheduleEditModal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
  <div class="bg-white rounded-lg shadow-xl w-full max-w-3xl max-h-[90vh] flex flex-col mx-4">
    <div class="px-6 py-4 border-b flex justify-between items-center">
      <h3 id="scheduleModalTitle" class="text-lg font-semibold"></h3>
      <button onclick="closeScheduleEditModal()" class="text-gray-400 hover:text-gray-600 text-xl">&times;</button>
    </div>
    <div class="p-6 flex-1 overflow-y-auto">
      <textarea id="scheduleContent" class="w-full h-96 font-mono text-sm p-4 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"></textarea>
    </div>
    <div class="px-6 py-4 border-t flex justify-between items-center">
      <span id="scheduleModalMeta" class="text-sm text-gray-500"></span>
      <div class="flex gap-2">
        <button onclick="closeScheduleEditModal()" class="px-4 py-2 text-gray-700 hover:bg-gray-100 rounded-lg">Cancel</button>
        <button onclick="saveSchedule()" class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700">Save</button>
      </div>
    </div>
  </div>
</div>

<!-- Schedule History Modal -->
<div id="scheduleHistoryModal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
  <div class="bg-white rounded-lg shadow-xl w-full max-w-3xl max-h-[90vh] flex flex-col mx-4">
    <div class="px-6 py-4 border-b flex justify-between items-center">
      <h3 id="historyModalTitle" class="text-lg font-semibold">Execution History</h3>
      <button onclick="closeScheduleHistoryModal()" class="text-gray-400 hover:text-gray-600 text-xl">&times;</button>
    </div>
    <div class="p-6 flex-1 overflow-y-auto">
      <table class="w-full">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Time</th>
            <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
            <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Duration</th>
            <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Result</th>
          </tr>
        </thead>
        <tbody id="historyTableBody" class="divide-y divide-gray-200">
          <tr><td colspan="4" class="px-4 py-4 text-center text-gray-500">Loading...</td></tr>
        </tbody>
      </table>
    </div>
    <div class="px-6 py-4 border-t flex justify-end">
      <button onclick="closeScheduleHistoryModal()" class="px-4 py-2 text-gray-700 hover:bg-gray-100 rounded-lg">Close</button>
    </div>
  </div>
</div>

<!-- Create Schedule Modal -->
<div id="createScheduleModal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
  <div class="bg-white rounded-lg shadow-xl w-full max-w-2xl max-h-[90vh] flex flex-col mx-4">
    <div class="px-6 py-4 border-b flex justify-between items-center">
      <h3 class="text-lg font-semibold">Create Schedule</h3>
      <button onclick="closeCreateScheduleModal()" class="text-gray-400 hover:text-gray-600 text-xl">&times;</button>
    </div>
    <div class="p-6 flex-1 overflow-y-auto">
      <form id="createScheduleForm" class="space-y-4">
        <!-- Basic Info -->
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Schedule ID *</label>
            <input type="text" id="newScheduleId" required pattern="[a-z0-9-]+"
              class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
              placeholder="daily-report">
            <p class="text-xs text-gray-400 mt-1">Used as filename (lowercase, numbers, hyphens only)</p>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Name *</label>
            <input type="text" id="newScheduleName" required
              class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
              placeholder="Daily Report">
          </div>
        </div>
        
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Description</label>
          <input type="text" id="newScheduleDescription"
            class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
            placeholder="Send daily report every morning">
        </div>

        <!-- Trigger Settings -->
        <div class="border-t pt-4">
          <h4 class="text-sm font-semibold text-gray-800 mb-3">Trigger</h4>
          <div class="grid grid-cols-2 gap-4 mb-3">
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Type *</label>
              <select id="newScheduleTriggerType" onchange="onTriggerTypeChange()"
                class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500">
                <option value="cron">Cron (週期性)</option>
                <option value="once">Once (一次性)</option>
                <option value="interval">Interval (固定間隔)</option>
              </select>
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Timezone</label>
              <select id="newScheduleTimezone"
                class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500">
                <option value="Asia/Taipei">Asia/Taipei (UTC+8)</option>
                <option value="Asia/Tokyo">Asia/Tokyo (UTC+9)</option>
                <option value="America/New_York">America/New_York (ET)</option>
                <option value="America/Los_Angeles">America/Los_Angeles (PT)</option>
                <option value="Europe/London">Europe/London (GMT)</option>
                <option value="UTC">UTC</option>
              </select>
            </div>
          </div>
          <!-- Cron fields -->
          <div id="triggerCronFields">
            <label class="block text-sm font-medium text-gray-700 mb-1">Cron Expression *</label>
            <input type="text" id="newScheduleCron"
              class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 font-mono"
              placeholder="0 9 * * *">
            <p id="cronDescription" class="text-xs text-gray-400 mt-1">Every day at 09:00</p>
          </div>
          <!-- Once fields -->
          <div id="triggerOnceFields" class="hidden">
            <label class="block text-sm font-medium text-gray-700 mb-1">Date & Time *</label>
            <input type="datetime-local" id="newScheduleAt"

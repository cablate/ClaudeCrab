// Schedule System
let schedulesLoaded = false;
let currentScheduleId = null;

async function loadSchedules() {
  if (schedulesLoaded) return;

  try {
    const response = await fetch('/api/agents/<%= agent.id %>/schedules');
    const data = await response.json();

    if (!response.ok) {
      document.getElementById('schedulesList').innerHTML =
        `<div class="text-center py-8 text-yellow-600">${data.error || 'Schedule system not available'}</div>`;
      return;
    }

    renderSchedules(data.schedules);
    schedulesLoaded = true;
  } catch (error) {
    console.error('Failed to load schedules:', error);
    document.getElementById('schedulesList').innerHTML =
      '<div class="text-center py-4 text-red-500">Failed to load schedules</div>';
  }
}

function renderSchedules(schedules) {
  const container = document.getElementById('schedulesList');

  if (schedules.length === 0) {
    container.innerHTML = `
      <div class="text-center py-8">
        <svg class="w-12 h-12 mx-auto text-gray-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        <p class="text-gray-500 mb-2">No scheduled tasks</p>
        <p class="text-sm text-gray-400">Ask the agent to create a scheduled task in conversation</p>
      </div>
    `;
    return;
  }

  container.innerHTML = `
    <div class="grid grid-cols-1 gap-4">
      ${schedules.map(schedule => {
        const spec = schedule.spec;
        const isEnabled = spec.metadata.enabled;
        const statusClass = isEnabled ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-600';
        const statusText = isEnabled ? 'Running' : 'Paused';
        const nextRun = schedule.nextRun ? new Date(schedule.nextRun).toLocaleString('zh-TW') : 'N/A';

        return `
          <div class="border rounded-lg p-4 hover:border-blue-300 transition-colors">
            <div class="flex justify-between items-start">
              <div class="flex-1">
                <div class="flex items-center gap-2">
                  <h4 class="font-medium text-gray-900">${spec.name}</h4>
                  <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium ${statusClass}">
                    ${statusText}
                  </span>
                </div>
                <p class="text-sm text-gray-500 mt-1">${spec.description || 'No description'}</p>
                <div class="mt-2 space-y-1">
                  <p class="text-xs text-gray-400">
                    <span class="font-medium">Cron:</span> ${spec.trigger.cron || 'N/A'} (${spec.trigger.timezone || 'UTC'})
                  </p>
                  <p class="text-xs text-gray-400">
                    <span class="font-medium">Next run:</span> ${nextRun}
                  </p>
                </div>
              </div>
              <div class="flex flex-col gap-1 ml-4">
                <button onclick="editSchedule('${spec.id}')" class="text-blue-600 hover:text-blue-800 text-sm">Edit</button>
                ${isEnabled
                  ? `<button onclick="pauseSchedule('${spec.id}')" class="text-yellow-600 hover:text-yellow-800 text-sm">Pause</button>`
                  : `<button onclick="resumeSchedule('${spec.id}')" class="text-green-600 hover:text-green-800 text-sm">Resume</button>`
                }
                <button onclick="runScheduleNow('${spec.id}')" class="text-purple-600 hover:text-purple-800 text-sm">Run Now</button>
                <button onclick="viewScheduleHistory('${spec.id}')" class="text-gray-600 hover:text-gray-800 text-sm">History</button>
                <button onclick="deleteSchedule('${spec.id}', '${spec.name}')" class="text-red-600 hover:text-red-800 text-sm">Delete</button>
              </div>
            </div>
          </div>
        `;
      }).join('')}
    </div>
  `;
}


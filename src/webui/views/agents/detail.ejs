<script>
function copyToken(token) {
  navigator.clipboard.writeText(token).then(() => {
    alert('Token copied to clipboard');
  }).catch(err => {
    console.error('Failed to copy:', err);
  });
}

async function reloadAgent(agentId) {
  if (!confirm(`Reload agent "${agentId}"?`)) return;

  try {
    const response = await fetch(`/api/agents/${agentId}/reload`, { method: 'POST' });
    const data = await response.json();

    if (response.ok) {
      alert(data.message);
      location.reload();
    } else {
      alert(`Error: ${data.error}`);
    }
  } catch (error) {
    alert(`Error: ${error.message}`);
  }
}

// Tab switching
function showTab(tabName) {
  // Hide all content
  document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
  // Remove active state from all tabs
  document.querySelectorAll('.tab-btn').forEach(el => {
    el.classList.remove('border-blue-500', 'text-blue-600');
    el.classList.add('border-transparent', 'text-gray-500');
  });
  // Show target content
  document.getElementById(`content-${tabName}`).classList.remove('hidden');
  // Activate target tab
  const activeTab = document.getElementById(`tab-${tabName}`);
  activeTab.classList.remove('border-transparent', 'text-gray-500');
  activeTab.classList.add('border-blue-500', 'text-blue-600');
  
  // Load memory files when switching to memory tab
  if (tabName === 'memory') {
    loadMemoryFiles();
  }
  // Load skills when switching to skills tab
  if (tabName === 'skills') {
    loadSkills();
  }
  // Load schedules when switching to schedules tab
  if (tabName === 'schedules') {
    loadSchedules();
  }
}

// Memory System
let currentMemoryFile = null;
let memoryLoaded = false;

async function loadMemoryFiles() {
  if (memoryLoaded) return;
  
  try {
    const response = await fetch('/api/agents/<%= agent.id %>/memory');
    const data = await response.json();
    renderCoreFiles(data.coreFiles);
    renderDailyLogs(data.dailyLogs);
    memoryLoaded = true;
  } catch (error) {
    console.error('Failed to load memory files:', error);
    document.getElementById('coreFilesGrid').innerHTML = 
      '<div class="col-span-2 text-center py-4 text-red-500">Failed to load memory files</div>';
  }
}

function renderCoreFiles(files) {
  const grid = document.getElementById('coreFilesGrid');
  grid.innerHTML = files.map(f => `
    <div class="border rounded-lg p-4 ${f.modified ? '' : 'opacity-50'}">
      <h4 class="font-medium text-gray-900">${f.name}</h4>
      <p class="text-sm text-gray-500">${f.description}</p>
      <p class="text-xs text-gray-400 mt-1">
        ${f.modified ? new Date(f.modified).toLocaleString('zh-TW') : 'Not created'}
      </p>
      <div class="mt-2 flex gap-2">
        ${f.modified ? `
          <button onclick="openMemoryFile('${f.path}')" class="text-sm text-blue-600 hover:text-blue-800">View/Edit</button>
        ` : `
          <button onclick="createMemoryFile('${f.path}')" class="text-sm text-green-600 hover:text-green-800">Create</button>
        `}
      </div>
    </div>
  `).join('');
}

function renderDailyLogs(logs) {
  const tbody = document.querySelector('#dailyLogsTable tbody');
  if (logs.length === 0) {
    tbody.innerHTML = '<tr><td colspan="3" class="px-6 py-4 text-center text-gray-500">No daily logs yet</td></tr>';
    return;
  }
  tbody.innerHTML = logs.map(f => `
    <tr class="hover:bg-gray-50">
      <td class="px-6 py-4 font-mono text-sm">${f.name.replace('.md', '')}</td>
      <td class="px-6 py-4 text-sm text-gray-500">${(f.size / 1024).toFixed(1)} KB</td>
      <td class="px-6 py-4 text-right">
        <button onclick="openMemoryFile('${f.path}')" class="text-blue-600 hover:text-blue-800 text-sm">View/Edit</button>
      </td>
    </tr>
  `).join('');
}

async function openMemoryFile(filePath) {
  try {
    const response = await fetch(`/api/agents/<%= agent.id %>/memory/file?path=${encodeURIComponent(filePath)}`);
    const data = await response.json();
    
    if (!response.ok) {
      alert('Failed to load file: ' + (data.error || 'Unknown error'));
      return;
    }
    
    currentMemoryFile = filePath;
    document.getElementById('modalTitle').textContent = filePath;
    document.getElementById('memoryContent').value = data.content;
    document.getElementById('modalMeta').textContent = `Last modified: ${new Date(data.modified).toLocaleString('zh-TW')}`;
    document.getElementById('memoryModal').classList.remove('hidden');
  } catch (error) {
    alert('Failed to load file: ' + error.message);
  }
}

function closeMemoryModal() {
  // Exit fullscreen if active
  const inner = document.getElementById('memoryModalInner');
  inner.classList.remove('fixed', 'inset-4', 'max-w-none', 'max-h-none', 'z-60');
  inner.classList.add('max-w-5xl', 'max-h-[90vh]', 'mx-4');
  document.getElementById('memoryModal').classList.add('hidden');
  currentMemoryFile = null;
}

function toggleMemoryFullscreen() {
  const inner = document.getElementById('memoryModalInner');
  const isFullscreen = inner.classList.contains('fixed');
  if (isFullscreen) {
    inner.classList.remove('fixed', 'inset-4', 'max-w-none', 'max-h-none', 'z-60');
    inner.classList.add('max-w-5xl', 'max-h-[90vh]', 'mx-4');
  } else {
    inner.classList.add('fixed', 'inset-4', 'max-w-none', 'max-h-none', 'z-60');
    inner.classList.remove('max-w-5xl', 'max-h-[90vh]', 'mx-4');
  }
}

async function saveMemoryFile() {
  const content = document.getElementById('memoryContent').value;
  try {
    const response = await fetch(`/api/agents/<%= agent.id %>/memory/file`, {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ path: currentMemoryFile, content })
    });
    const data = await response.json();
    
    if (data.success) {
      closeMemoryModal();
      memoryLoaded = false; // Force reload
      loadMemoryFiles();
    } else {
      alert('Failed to save: ' + (data.error || 'Unknown error'));
    }
  } catch (error) {
    alert('Failed to save: ' + error.message);
  }
}

function createMemoryFile(filePath) {
  currentMemoryFile = filePath;
  document.getElementById('modalTitle').textContent = `Create ${filePath}`;
  document.getElementById('memoryContent').value = `# ${filePath.replace('.md', '')}\n\n`;
  document.getElementById('modalMeta').textContent = 'New file';
  document.getElementById('memoryModal').classList.remove('hidden');
}

// Close modal on escape key
document.addEventListener('keydown', (e) => {
  if (e.key === 'Escape') {
    closeMemoryModal();
    closeSkillUploadModal();
    closeSkillEditModal();
    closeScheduleEditModal();
    closeScheduleHistoryModal();
    closeCreateScheduleModal();
  }
});


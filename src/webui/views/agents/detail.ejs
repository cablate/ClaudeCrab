function closeSkillUploadModal() {
  document.getElementById('skillUploadModal').classList.add('hidden');
  document.getElementById('skillFile').value = '';
  document.getElementById('uploadProgress').classList.add('hidden');
}

document.getElementById('skillUploadForm').addEventListener('submit', async (e) => {
  e.preventDefault();

  const fileInput = document.getElementById('skillFile');
  const file = fileInput.files[0];
  if (!file) return;

  const formData = new FormData();
  formData.append('file', file);

  document.getElementById('uploadProgress').classList.remove('hidden');

  try {
    const response = await fetch('/api/agents/<%= agent.id %>/skills', {
      method: 'POST',
      body: formData
    });
    const data = await response.json();

    if (response.ok) {
      closeSkillUploadModal();
      skillsLoaded = false;
      loadSkills();
      alert(`Skill "${data.skill.name}" installed successfully!`);
    } else {
      alert('Upload failed: ' + (data.error || 'Unknown error'));
    }
  } catch (error) {
    alert('Upload failed: ' + error.message);
  } finally {
    document.getElementById('uploadProgress').classList.add('hidden');
  }
});


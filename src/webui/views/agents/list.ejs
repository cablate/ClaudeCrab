<%- include('../partials/start', { title }) %>

<!-- Agents List -->
<div class="bg-white rounded-lg shadow-sm border border-gray-200">
  <div class="px-6 py-4 border-b border-gray-200">
    <div class="flex items-center justify-between">
      <p class="text-sm text-gray-500"><%= agents.length %> agents found</p>
      <a href="/agents/create" class="inline-flex items-center px-3 py-1.5 border border-transparent text-sm font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
        <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
        </svg>
        New Agent
      </a>
    </div>
  </div>

  <% if (agents.length === 0) { %>
    <div class="p-6">
      <%- include('../components/empty-state', {
        title: 'No agents found',
        message: 'Create an agent by adding a folder with agent.json in the agents/ directory',
        icon: 'M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z'
      }) %>
    </div>
  <% } else { %>
    <div class="overflow-x-auto">
      <table class="w-full">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Agent</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Version</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Model</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Bot Status</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Sessions</th>
            <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200">
          <% agents.forEach(agent => { %>
            <tr class="hover:bg-gray-50 transition-colors">
              <td class="px-6 py-4">
                <div>
                  <p class="font-medium text-gray-900"><%= agent.name %></p>
                  <p class="text-sm text-gray-500"><%= agent.description || agent.id %></p>
                </div>
              </td>
              <td class="px-6 py-4">
                <span class="text-sm text-gray-500">v<%= agent.version || '1.0.0' %></span>
              </td>
              <td class="px-6 py-4">
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                  <%= agent.model %>
                </span>
              </td>
              <td class="px-6 py-4">
                <% if (agent.botStatus.length === 0) { %>
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-600">
                    No Bot
                  </span>
                <% } else { %>
                  <div class="flex flex-col gap-1">
                    <% agent.botStatus.forEach(bot => { %>
                      <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-medium <%= bot.status === 'running' ? 'bg-green-100 text-green-800' : 'bg-yellow-100 text-yellow-800' %>">
                        <span class="w-1.5 h-1.5 rounded-full <%= bot.status === 'running' ? 'bg-green-500' : 'bg-yellow-500' %>"></span>
                        <%= bot.platform %> · <%= bot.status %>
                      </span>
                    <% }) %>
                  </div>
                <% } %>
              </td>
              <td class="px-6 py-4">
                <span class="text-sm font-medium text-gray-900"><%= agent.sessionCount %></span>
              </td>
              <td class="px-6 py-4 text-right">
                <div class="flex items-center justify-end gap-2">
                  <a href="/agents/<%= agent.id %>" class="text-blue-600 hover:text-blue-800 text-sm font-medium">
                    View
                  </a>
                  <% const runningBot = agent.botStatus.find(b => b.status === 'running'); %>
                  <% const hasToken = agent.botStatus.length > 0 || agent.hasBotToken; %>
                  <% if (hasToken) { %>
                    <% if (runningBot) { %>
                      <button
                        onclick="stopBot('<%= agent.id %>')"
                        class="text-orange-600 hover:text-orange-800 text-sm font-medium"
                        title="Stop Telegram Bot"
                      >
                        Stop Bot
                      </button>
                    <% } else { %>
                      <button
                        onclick="startBot('<%= agent.id %>')"
                        class="text-green-600 hover:text-green-800 text-sm font-medium"
                        title="Start Telegram Bot"
                      >
                        Start Bot
                      </button>
                    <% } %>
                  <% } %>
                  <button
                    onclick="reloadAgent('<%= agent.id %>')"
                    class="text-gray-600 hover:text-gray-800 text-sm font-medium"
                  >
                    Reload
                  </button>
                  <button
                    onclick="showCloneModal('<%= agent.id %>', '<%= agent.name %>')"
                    class="text-purple-600 hover:text-purple-800 text-sm font-medium"
                  >
                    Clone
                  </button>
                  <% if (agent.id !== '_example') { %>
                    <button
                      onclick="showDeleteModal('<%= agent.id %>', '<%= agent.name %>', <%= agent.sessionCount %>)"
                      class="text-red-600 hover:text-red-800 text-sm font-medium"
                    >
                      Delete
                    </button>
                  <% } %>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<!-- Clone Modal -->
<div id="cloneModal" class="fixed inset-0 bg-gray-600 bg-opacity-50 hidden items-center justify-center z-50">
  <div class="bg-white rounded-lg shadow-xl max-w-md w-full mx-4">
    <div class="px-6 py-4 border-b border-gray-200">
      <h3 class="text-lg font-medium text-gray-900">Clone Agent</h3>
    </div>
    <div class="px-6 py-4">
      <p class="text-sm text-gray-600 mb-4">
        Create a copy of agent "<span id="cloneAgentName" class="font-medium"></span>".
      </p>
      <div class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">New Agent ID <span class="text-red-500">*</span></label>
          <input type="text" id="cloneNewId" placeholder="e.g., my-new-agent" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
          <p class="mt-1 text-xs text-gray-500">Lowercase letters, numbers, and hyphens only</p>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">New Agent Name</label>
          <input type="text" id="cloneNewName" placeholder="Leave empty for auto-generated name" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
        </div>
        <div>
          <label class="flex items-center">
            <input type="checkbox" id="cloneKeepMemory" class="rounded border-gray-300 text-blue-600 focus:ring-blue-500">
            <span class="ml-2 text-sm text-gray-600">Keep memory files (USER.md, MEMORY.md, daily logs)</span>
          </label>
        </div>
      </div>
    </div>
    <div class="px-6 py-4 border-t border-gray-200 flex justify-end gap-3">
      <button onclick="closeCloneModal()" class="px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 hover:bg-gray-200 rounded-md">
        Cancel
      </button>
      <button onclick="confirmClone()" class="px-4 py-2 text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 rounded-md">
        Clone
      </button>
    </div>
  </div>
</div>

<!-- Delete Confirmation Modal -->
<div id="deleteModal" class="fixed inset-0 bg-gray-600 bg-opacity-50 hidden items-center justify-center z-50">
  <div class="bg-white rounded-lg shadow-xl max-w-md w-full mx-4">
    <div class="px-6 py-4 border-b border-gray-200">
      <h3 class="text-lg font-medium text-gray-900">Delete Agent</h3>
    </div>
    <div class="px-6 py-4">
      <p class="text-sm text-gray-600 mb-4">
        Are you sure you want to delete agent "<span id="deleteAgentName" class="font-medium"></span>"?
      </p>
      <div id="deleteSessionWarning" class="mb-4 p-3 bg-yellow-50 border border-yellow-200 rounded-md hidden">
        <p class="text-sm text-yellow-800">
          <strong>Warning:</strong> This agent has <span id="deleteSessionCount"></span> active session(s) that will be closed.
        </p>
      </div>
      <div class="mb-4">
        <label class="flex items-center">
          <input type="checkbox" id="hardDeleteCheckbox" class="rounded border-gray-300 text-red-600 focus:ring-red-500">
          <span class="ml-2 text-sm text-gray-600">Permanently delete (cannot be recovered)</span>
        </label>
      </div>
      <div id="hardDeleteConfirm" class="mb-4 hidden">
        <label class="block text-sm font-medium text-gray-700 mb-1">
          Type "<span id="confirmAgentId" class="font-mono text-red-600"></span>" to confirm:
        </label>
        <input type="text" id="hardDeleteInput" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-red-500">
      </div>
    </div>
    <div class="px-6 py-4 border-t border-gray-200 flex justify-end gap-3">
      <button onclick="closeDeleteModal()" class="px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 hover:bg-gray-200 rounded-md">
        Cancel
      </button>
      <button id="deleteConfirmBtn" onclick="confirmDelete()" class="px-4 py-2 text-sm font-medium text-white bg-red-600 hover:bg-red-700 rounded-md">
        Delete
      </button>
    </div>
  </div>
</div>

<script>
let deleteAgentId = null;
let cloneAgentId = null;

// Clone functions
function showCloneModal(agentId, agentName) {
  cloneAgentId = agentId;
  document.getElementById('cloneAgentName').textContent = agentName;
  document.getElementById('cloneNewId').value = '';
  document.getElementById('cloneNewName').value = '';
  document.getElementById('cloneKeepMemory').checked = false;

  const modal = document.getElementById('cloneModal');
  modal.classList.remove('hidden');
  modal.classList.add('flex');
  document.getElementById('cloneNewId').focus();
}

function closeCloneModal() {
  const modal = document.getElementById('cloneModal');
  modal.classList.add('hidden');
  modal.classList.remove('flex');
  cloneAgentId = null;
}

async function confirmClone() {
  if (!cloneAgentId) return;

  const newId = document.getElementById('cloneNewId').value.trim();
  const newName = document.getElementById('cloneNewName').value.trim();
  const keepMemory = document.getElementById('cloneKeepMemory').checked;

  if (!newId) {
    alert('Please enter a new agent ID.');
    return;
  }

  if (!/^[a-z0-9-]+$/.test(newId)) {
    alert('Invalid ID. Use only lowercase letters, numbers, and hyphens.');
    return;
  }

  try {
    const response = await fetch(`/api/agents/${cloneAgentId}/clone`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        newId,
        newName: newName || undefined,
        keepMemory
      })
    });
    const data = await response.json();

    if (response.ok) {
      closeCloneModal();
      alert(data.message);
      location.reload();
    } else {
      alert(`Error: ${data.error}`);
    }
  } catch (error) {
    alert(`Error: ${error.message}`);
  }
}

// Close clone modal when clicking outside
document.getElementById('cloneModal').addEventListener('click', function(e) {
  if (e.target === this) {
    closeCloneModal();
  }
});

async function reloadAgent(agentId) {
  if (!confirm(`Reload agent "${agentId}"?`)) return;

  try {
    const response = await fetch(`/api/agents/${agentId}/reload`, { method: 'POST' });
    const data = await response.json();

    if (response.ok) {
      alert(data.message);
      location.reload();
    } else {
      alert(`Error: ${data.error}`);
    }
  } catch (error) {
    alert(`Error: ${error.message}`);
  }
}

async function startBot(agentId) {
  if (!confirm(`Start bot for agent "${agentId}"?`)) return;

  try {
    const response = await fetch(`/api/agents/${agentId}/bot/start`, { method: 'POST' });
    const data = await response.json();

    if (response.ok) {
      alert(data.message);
      location.reload();
    } else {
      alert(`Error: ${data.error}`);
    }
  } catch (error) {
    alert(`Error: ${error.message}`);
  }
}

async function stopBot(agentId) {
  if (!confirm(`Stop bot for agent "${agentId}"?`)) return;

  try {
    const response = await fetch(`/api/agents/${agentId}/bot/stop`, { method: 'POST' });
    const data = await response.json();

    if (response.ok) {
      alert(data.message);
      location.reload();
    } else {
      alert(`Error: ${data.error}`);
    }
  } catch (error) {
    alert(`Error: ${error.message}`);
  }
}

function showDeleteModal(agentId, agentName, sessionCount) {
  deleteAgentId = agentId;
  document.getElementById('deleteAgentName').textContent = agentName;
  document.getElementById('confirmAgentId').textContent = agentId;
  
  // Show session warning if there are active sessions
  const warningEl = document.getElementById('deleteSessionWarning');
  if (sessionCount > 0) {
    document.getElementById('deleteSessionCount').textContent = sessionCount;
    warningEl.classList.remove('hidden');
  } else {
    warningEl.classList.add('hidden');
  }

  // Reset hard delete section
  document.getElementById('hardDeleteCheckbox').checked = false;
  document.getElementById('hardDeleteConfirm').classList.add('hidden');
  document.getElementById('hardDeleteInput').value = '';

  // Show modal
  const modal = document.getElementById('deleteModal');
  modal.classList.remove('hidden');
  modal.classList.add('flex');
}

function closeDeleteModal() {
  const modal = document.getElementById('deleteModal');
  modal.classList.add('hidden');
  modal.classList.remove('flex');
  deleteAgentId = null;
}

// Toggle hard delete confirmation input
document.getElementById('hardDeleteCheckbox').addEventListener('change', function() {
  const confirmEl = document.getElementById('hardDeleteConfirm');
  if (this.checked) {
    confirmEl.classList.remove('hidden');
  } else {
    confirmEl.classList.add('hidden');
    document.getElementById('hardDeleteInput').value = '';
  }
});

async function confirmDelete() {
  if (!deleteAgentId) return;

  const isHardDelete = document.getElementById('hardDeleteCheckbox').checked;
  
  // Validate hard delete confirmation
  if (isHardDelete) {
    const confirmInput = document.getElementById('hardDeleteInput').value;
    if (confirmInput !== deleteAgentId) {
      alert('Please type the agent ID correctly to confirm hard deletion.');
      return;
    }
  }

  try {
    const params = new URLSearchParams();
    if (isHardDelete) params.set('hard', 'true');
    params.set('force', 'true'); // Always force since we showed the warning

    const url = `/api/agents/${deleteAgentId}${params.toString() ? '?' + params.toString() : ''}`;
    const response = await fetch(url, { method: 'DELETE' });
    const data = await response.json();

    if (response.ok) {
      closeDeleteModal();
      alert(data.message);
      location.reload();
    } else {
      alert(`Error: ${data.error}`);
    }
  } catch (error) {
    alert(`Error: ${error.message}`);
  }
}

// Close modal when clicking outside
document.getElementById('deleteModal').addEventListener('click', function(e) {
  if (e.target === this) {
    closeDeleteModal();
  }
});
</script>

<%- include('../partials/end') %>

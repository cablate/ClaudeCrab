<%- include('../partials/start', { title }) %>

<!-- Agents List -->
<div class="bg-white rounded-lg shadow-sm border border-gray-200">
  <div class="px-6 py-4 border-b border-gray-200">
    <div class="flex items-center justify-between">
      <p class="text-sm text-gray-500"><%= agents.length %> agents found</p>
      <a href="/agents/create" class="inline-flex items-center px-3 py-1.5 border border-transparent text-sm font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
        <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
        </svg>
        New Agent
      </a>
    </div>
  </div>

  <% if (agents.length === 0) { %>
    <div class="p-6">
      <%- include('../components/empty-state', {
        title: 'No agents found',
        message: 'Create an agent by adding a folder with agent.json in the agents/ directory',
        icon: 'M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z'
      }) %>
    </div>
  <% } else { %>
    <div class="overflow-x-auto">
      <table class="w-full">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Agent</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Model</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Bot Status</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Sessions</th>
            <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200">
          <% agents.forEach(agent => { %>
            <tr class="hover:bg-gray-50 transition-colors">
              <td class="px-6 py-4">
                <div>
                  <p class="font-medium text-gray-900"><%= agent.name %></p>
                  <p class="text-sm text-gray-500"><%= agent.description || agent.id %></p>
                </div>
              </td>
              <td class="px-6 py-4">
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                  <%= agent.model %>
                </span>
              </td>
              <td class="px-6 py-4">
                <% if (agent.botStatus.length === 0) { %>
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-600">
                    No Bot
                  </span>
                <% } else { %>
                  <div class="flex flex-col gap-1">
                    <% agent.botStatus.forEach(bot => { %>
                      <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-medium <%= bot.status === 'running' ? 'bg-green-100 text-green-800' : 'bg-yellow-100 text-yellow-800' %>">
                        <span class="w-1.5 h-1.5 rounded-full <%= bot.status === 'running' ? 'bg-green-500' : 'bg-yellow-500' %>"></span>
                        <%= bot.platform %> · <%= bot.status %>
                      </span>
                    <% }) %>
                  </div>
                <% } %>
              </td>
              <td class="px-6 py-4">
                <span class="text-sm font-medium text-gray-900"><%= agent.sessionCount %></span>
              </td>
              <td class="px-6 py-4 text-right">
                <div class="flex items-center justify-end gap-2">
                  <a href="/agents/<%= agent.id %>" class="text-blue-600 hover:text-blue-800 text-sm font-medium">
                    View
                  </a>
                  <button
                    onclick="reloadAgent('<%= agent.id %>')"
                    class="text-gray-600 hover:text-gray-800 text-sm font-medium"
                  >
                    Reload
                  </button>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<script>
async function reloadAgent(agentId) {
  if (!confirm(`Reload agent "${agentId}"?`)) return;

  try {
    const response = await fetch(`/api/agents/${agentId}/reload`, { method: 'POST' });
    const data = await response.json();

    if (response.ok) {
      alert(data.message);
      location.reload();
    } else {
      alert(`Error: ${data.error}`);
    }
  } catch (error) {
    alert(`Error: ${error.message}`);
  }
}
</script>

<%- include('../partials/end') %>

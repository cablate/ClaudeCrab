<%- include('../partials/start', { title }) %>

<!-- Back Button -->
<a href="/sessions" class="inline-flex items-center gap-2 text-gray-600 hover:text-gray-900 mb-6">
  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
  </svg>
  Back to Sessions
</a>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  <!-- Session Info -->
  <div class="lg:col-span-1">
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-lg font-semibold text-gray-800">Session Info</h3>
        <%- include('../components/status-badge', { status: session.state }) %>
      </div>

      <dl class="space-y-4">
        <div>
          <dt class="text-sm text-gray-500">Session ID</dt>
          <dd class="mt-1 font-mono text-xs text-gray-900 break-all"><%= session.sessionId %></dd>
        </div>
        <div>
          <dt class="text-sm text-gray-500">Platform</dt>
          <dd class="mt-1 font-medium text-gray-900 capitalize"><%= session.platform %></dd>
        </div>
        <div>
          <dt class="text-sm text-gray-500">User ID</dt>
          <dd class="mt-1 font-mono text-sm text-gray-900"><%= session.userId %></dd>
        </div>
        <div>
          <dt class="text-sm text-gray-500">Agent</dt>
          <dd class="mt-1">
            <a href="/agents/<%= session.agentId %>" class="text-blue-600 hover:text-blue-800 font-medium">
              <%= session.agentName %>
            </a>
          </dd>
        </div>
        <div>
          <dt class="text-sm text-gray-500">Messages Processed</dt>
          <dd class="mt-1 text-gray-900"><%= session.messageCount %></dd>
        </div>
        <div>
          <dt class="text-sm text-gray-500">Created</dt>
          <dd class="mt-1 text-sm text-gray-900"><%= new Date(session.createdAt).toLocaleString('zh-TW') %></dd>
        </div>
        <div>
          <dt class="text-sm text-gray-500">Last Active</dt>
          <dd class="mt-1 text-sm text-gray-900"><%= new Date(session.lastActiveAt).toLocaleString('zh-TW') %></dd>
        </div>
        <% if (session.sdkSessionId) { %>
          <div>
            <dt class="text-sm text-gray-500">SDK Session ID</dt>
            <dd class="mt-1 font-mono text-xs text-gray-500 break-all"><%= session.sdkSessionId %></dd>
          </div>
        <% } %>
      </dl>

      <div class="mt-6 pt-4 border-t border-gray-200 space-y-3">
        <a
          href="/conversations/<%= session.sessionId %>"
          class="block w-full px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg text-center transition-colors"
        >
          View Full Conversation
        </a>
        <button
          onclick="closeSession('<%= session.sessionId %>')"
          class="w-full px-4 py-2 bg-red-100 hover:bg-red-200 text-red-700 font-medium rounded-lg transition-colors"
        >
          Close Session
        </button>
      </div>
    </div>
  </div>

  <!-- Conversation Preview -->
  <div class="lg:col-span-2">
    <div class="bg-white rounded-lg shadow-sm border border-gray-200">
      <div class="px-6 py-4 border-b border-gray-200 flex items-center justify-between">
        <h3 class="text-lg font-semibold text-gray-800">Conversation (<%= conversations.length %> messages)</h3>
        <% if (conversations.length > 0) { %>
          <a href="/conversations/<%= session.sessionId %>" class="text-sm text-blue-600 hover:text-blue-700">
            View Full &rarr;
          </a>
        <% } %>
      </div>

      <% if (conversations.length === 0) { %>
        <div class="p-6">
          <%- include('../components/empty-state', {
            title: 'No messages yet',
            message: 'Conversation history will appear here'
          }) %>
        </div>
      <% } else { %>
        <div class="p-6 space-y-4 max-h-[600px] overflow-y-auto">
          <% conversations.slice(-10).forEach(msg => { %>
            <div class="flex gap-3 <%= msg.role === 'user' ? '' : 'flex-row-reverse' %>">
              <div class="flex-shrink-0 w-8 h-8 rounded-full flex items-center justify-center <%= msg.role === 'user' ? 'bg-blue-100' : 'bg-gray-100' %>">
                <% if (msg.role === 'user') { %>
                  <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                  </svg>
                <% } else { %>
                  <svg class="w-4 h-4 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
                  </svg>
                <% } %>
              </div>
              <div class="flex-1 <%= msg.role === 'user' ? 'text-left' : 'text-right' %>">
                <div class="inline-block max-w-[80%] <%= msg.role === 'user' ? 'bg-blue-50 text-left' : 'bg-gray-50 text-left' %> rounded-lg px-4 py-2">
                  <p class="text-sm text-gray-900 whitespace-pre-wrap"><%= msg.content.length > 500 ? msg.content.slice(0, 500) + '...' : msg.content %></p>
                </div>
                <p class="text-xs text-gray-400 mt-1">
                  <%= new Date(msg.createdAt).toLocaleString('zh-TW') %>
                </p>
              </div>
            </div>
          <% }) %>

          <% if (conversations.length > 10) { %>
            <div class="text-center py-4">
              <a href="/conversations/<%= session.sessionId %>" class="text-blue-600 hover:text-blue-700 text-sm">
                View all <%= conversations.length %> messages &rarr;
              </a>
            </div>
          <% } %>
        </div>
      <% } %>
    </div>
  </div>
</div>

<script>
async function closeSession(sessionId) {
  if (!confirm('Close this session? The user will need to start a new conversation.')) return;

  try {
    const response = await fetch(`/api/sessions/${sessionId}`, { method: 'DELETE' });
    const data = await response.json();

    if (response.ok) {
      alert(data.message);
      window.location.href = '/sessions';
    } else {
      alert(`Error: ${data.error}`);
    }
  } catch (error) {
    alert(`Error: ${error.message}`);
  }
}
</script>

<%- include('../partials/end') %>

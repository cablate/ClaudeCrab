<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ClaudeCab Live</title>
  <link rel="stylesheet" href="/static/css/live.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
</head>
<body>
  <!-- Header -->
  <header class="live-header">
    <div class="header-left">
      <h1>ClaudeCab <span class="header-accent">Live</span></h1>
      <div class="subtitle">
        <span id="connection-dot" class="connection-dot"></span>
        <span>虛擬辦公室</span>
      </div>
    </div>
    <div class="header-stats">
      <div class="mini-stat"><span class="mini-stat-icon">💬</span><span class="mini-stat-value" id="stat-messages">0</span><span class="mini-stat-label">訊息</span></div>
      <div class="mini-stat"><span class="mini-stat-icon">✅</span><span class="mini-stat-value" id="stat-completed">0</span><span class="mini-stat-label">完成</span></div>
      <div class="mini-stat"><span class="mini-stat-icon">🧠</span><span class="mini-stat-value" id="stat-personality">0</span><span class="mini-stat-label">獨白</span></div>
    </div>
  </header>

  <!-- Main Layout: Characters (hero) + Feed (sidebar) -->
  <main class="office-layout">
    <!-- Left: Employee Cards (hero area) -->
    <section class="office-main">
      <div class="agent-cards" id="agent-cards">
        <div class="empty-state">
          <div class="icon">🏢</div>
          <p>辦公室準備中...</p>
        </div>
      </div>
    </section>

    <!-- Right: Activity Feed (sidebar) -->
    <aside class="office-sidebar">
      <div class="sidebar-header">
        <h2 class="sidebar-title">📋 辦公室動態</h2>
        <div class="feed-filters" id="feed-filters">
          <button class="filter-btn active" data-filter="all">全部</button>
          <button class="filter-btn" data-filter="workflow">工作</button>
          <button class="filter-btn" data-filter="personality">心聲</button>
        </div>
      </div>
      <div class="feed-container" id="activity-feed">
        <!-- Events will be added here -->
      </div>
    </aside>
  </main>

  <script src="/static/js/live.js"></script>
</body>
</html>

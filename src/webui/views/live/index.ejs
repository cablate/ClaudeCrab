<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ClaudeCab Live</title>
  <link rel="stylesheet" href="/static/css/live.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
</head>
<body>
  <!-- Header -->
  <header class="live-header">
    <h1>ClaudeCab Live</h1>
    <div class="subtitle">
      <span id="connection-dot" class="connection-dot"></span>
      <span>Real-time Agent Activity</span>
    </div>
  </header>

  <!-- Agent Cards -->
  <section class="agent-cards" id="agent-cards">
    <div class="empty-state">
      <div class="icon">...</div>
      <p>Loading agents...</p>
    </div>
  </section>

  <!-- Activity Feed -->
  <section class="feed-section">
    <div class="feed-header">
      <h2 class="feed-title">Activity Feed</h2>
      <div class="feed-filters" id="feed-filters">
        <button class="filter-btn active" data-filter="all">All</button>
        <button class="filter-btn" data-filter="workflow">Workflow</button>
        <button class="filter-btn" data-filter="personality">Personality</button>
      </div>
    </div>
    <div class="feed-container" id="activity-feed">
      <!-- Events will be added here -->
    </div>
  </section>

  <script src="/static/js/live.js"></script>
</body>
</html>

<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ClaudeCrab 🦀</title>
  <link rel="stylesheet" href="/static/css/live.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
</head>
<body>
  <!-- Title Screen (Galgame style) -->
  <div class="title-screen" id="title-screen">
    <div class="title-bg">
      <img class="title-bg-img" src="/static/images/office-background-cny.png" alt="">
      <div class="title-bg-overlay"></div>
    </div>
    <div class="title-characters">
      <img class="title-char-img" src="/static/images/title-cny.png" alt="">
    </div>
    <div class="title-logo-area">
      <h1 class="title-logo">Claude<span class="logo-crab">Crab</span><span class="logo-crab-emoji">🦀</span></h1>
      <p class="title-subtitle">新年快樂 — Happy Lunar New Year 2026</p>
    </div>
    <nav class="title-menu">
      <button class="title-menu-item" id="title-start"><span class="title-menu-label">はじめる</span><span class="title-menu-en">START</span></button>
    </nav>
    <div class="title-particles" id="title-particles"></div>
    <div class="title-lanterns">
      <span class="lantern l1">🏮</span>
      <span class="lantern l2">🏮</span>
      <span class="lantern l3">🏮</span>
      <span class="lantern l4">🏮</span>
      <span class="lantern l5">🏮</span>
    </div>
  </div>

  <!-- Header -->
  <header class="live-header">
    <div class="header-left">
      <h1>Claude<span class="header-accent">Crab</span> 🦀</h1>
      <div class="subtitle">
        <span id="connection-dot" class="connection-dot"></span>
        <span>虛擬辦公室</span>
        <span class="header-clock" id="header-clock"></span>
      </div>
    </div>
    <button class="header-menu-btn" id="header-menu-btn" title="主選單">☰</button>
    <div class="header-stats">
      <div class="mini-stat clickable" data-menu-tab="usage"><span class="mini-stat-icon">💰</span><span class="mini-stat-value" id="stat-cost">--</span><span class="mini-stat-label">花費</span></div>
      <div class="mini-stat clickable" data-menu-tab="usage"><span class="mini-stat-icon">⚡</span><span class="mini-stat-value" id="stat-queries">--</span><span class="mini-stat-label">查詢</span></div>
      <div class="mini-stat"><span class="mini-stat-icon">💬</span><span class="mini-stat-value" id="stat-messages">0</span><span class="mini-stat-label">訊息</span></div>
      <div class="mini-stat"><span class="mini-stat-icon">✅</span><span class="mini-stat-value" id="stat-completed">0</span><span class="mini-stat-label">完成</span></div>
      <div class="mini-stat"><span class="mini-stat-icon">🧠</span><span class="mini-stat-value" id="stat-personality">0</span><span class="mini-stat-label">獨白</span></div>
      <div class="mini-stat clickable" data-menu-tab="system"><span class="mini-stat-icon">⏱</span><span class="mini-stat-value" id="stat-uptime">--</span><span class="mini-stat-label">uptime</span></div>
    </div>
  </header>

  <!-- Main Layout: Characters (hero) + Feed (sidebar) -->
  <main class="office-layout">
    <!-- Left: Employee Cards (hero area) -->
    <section class="office-main">
      <!-- Isometric Office Scene -->
      <div class="office-scene" id="office-scene">
        <!-- Day/Night sky background (behind office) -->
        <div class="sky-layer" id="sky-layer"></div>
        <img class="office-bg" src="/static/images/office-background.png" alt="Office">
        <!-- Agent sprites will be positioned here by JS -->
        <button class="scene-edit-btn" id="scene-edit-btn" title="編輯模式">🔧 編輯</button>
        <!-- Edit mode toolbar (hidden by default) -->
        <div class="edit-toolbar hidden" id="edit-toolbar">
          <div class="edit-toolbar-left">
            <button class="edit-toolbar-bg" id="edit-bg-btn" title="切換背景">🖼️ 背景</button>
            <div class="edit-bg-picker hidden" id="edit-bg-picker">
              <button class="bg-picker-item" data-bg="default">
                <img src="/static/images/office-background.png" alt="Default">
                <span>預設</span>
              </button>
              <button class="bg-picker-item" data-bg="cny">
                <img src="/static/images/office-background-cny.png" alt="CNY">
                <span>新年</span>
              </button>
            </div>
          </div>
          <div class="edit-toolbar-right">
            <button class="edit-toolbar-cancel" id="edit-cancel" title="取消">✕</button>
            <button class="edit-toolbar-save" id="edit-save" title="儲存">✓</button>
          </div>
        </div>

        <!-- RPG Dialogue Panel (hidden by default, inside scene) -->
        <div class="dialogue-overlay" id="dialogue-overlay">
          <div class="dialogue-backdrop"></div>
          <div class="dialogue-scene">
            <button class="dialogue-close" id="dialogue-close">&times;</button>
            <div class="dialogue-portrait">
              <img class="dialogue-portrait-img" id="dialogue-portrait-img" src="" alt="">
            </div>
            <div class="dialogue-content">
              <div class="dialogue-nameplate">
                <span class="dialogue-name" id="dialogue-name"></span>
                <span class="dialogue-status" id="dialogue-status"></span>
                <div class="dialogue-nameplate-actions">
                  <button class="dialogue-stats-toggle" id="dialogue-stats-toggle">📊 屬性</button>
                  <button class="dialogue-history-toggle" id="dialogue-history-toggle">📜 紀錄</button>
                </div>
              </div>
              <div class="dialogue-box">
                <div class="dialogue-box-inner" id="dialogue-box-inner">
                  <div class="dialogue-task-context" id="dialogue-task-context" style="display:none;"></div>
                  <div class="dialogue-text" id="dialogue-text"></div>
                </div>
                <div class="dialogue-emoji" id="dialogue-emoji"></div>
                <!-- Agent Stats Panel — overlays dialogue text when active -->
                <div class="dialogue-stats-panel" id="dialogue-stats-panel" style="display:none;">
                  <div class="stats-panel-grid">
                    <div class="stats-panel-item"><span class="stats-panel-label">24h 花費</span><span class="stats-panel-value" id="stats-cost">--</span></div>
                    <div class="stats-panel-item"><span class="stats-panel-label">查詢數</span><span class="stats-panel-value" id="stats-queries">--</span></div>
                    <div class="stats-panel-item"><span class="stats-panel-label">IN tokens</span><span class="stats-panel-value" id="stats-in">--</span></div>
                    <div class="stats-panel-item"><span class="stats-panel-label">OUT tokens</span><span class="stats-panel-value" id="stats-out">--</span></div>
                    <div class="stats-panel-item"><span class="stats-panel-label">Model</span><span class="stats-panel-value" id="stats-model">--</span></div>
                    <div class="stats-panel-item"><span class="stats-panel-label">Bot</span><span class="stats-panel-value" id="stats-bot-status">--</span></div>
                  </div>
                </div>
              </div>

              <!-- Quick Reply Buttons -->
              <div class="dialogue-quick-replies">
                <button class="quick-reply-btn" data-text="最近怎麼樣？">最近怎麼樣？</button>
                <button class="quick-reply-btn" data-text="有什麼需要幫忙的嗎？">有什麼需要幫忙的嗎？</button>
                <button class="quick-reply-btn" data-text="聊聊天吧">聊聊天吧</button>
              </div>

              <!-- Text Input -->
              <div class="dialogue-input-container">
                <textarea class="dialogue-input" id="dialogue-input" placeholder="輸入訊息..." rows="1"></textarea>
                <button class="dialogue-send-btn" id="dialogue-send-btn">
                  <span class="send-text">送出</span>
                </button>
              </div>
            </div>
          </div>
        </div>

        <!-- Backlog Modal (Star Rail style) -->
        <div class="backlog-overlay" id="backlog-overlay">
          <div class="backlog-backdrop"></div>
          <div class="backlog-panel">
            <div class="backlog-header">
              <h3 class="backlog-title">📜 劇情回顧</h3>
              <span class="backlog-agent-name" id="backlog-agent-name"></span>
              <button class="backlog-close" id="backlog-close">&times;</button>
            </div>
            <div class="backlog-scroll" id="backlog-scroll">
              <!-- History entries rendered by JS -->
            </div>
          </div>
        </div>
        <!-- Game Menu Overlay -->
        <div class="game-menu-overlay" id="game-menu-overlay">
          <div class="game-menu-backdrop"></div>
          <div class="game-menu-panel">
            <button class="game-menu-close" id="game-menu-close">&times;</button>
            <nav class="game-menu-nav">
              <button class="game-menu-tab active" data-tab="usage">📊 用量</button>
              <button class="game-menu-tab" data-tab="sessions">💬 任務</button>
              <button class="game-menu-tab" data-tab="system">🖥 系統</button>
              <button class="game-menu-tab" data-tab="agents">👥 成員</button>
            </nav>
            <div class="game-menu-content">
              <!-- Auth gate -->
              <div class="game-menu-auth-gate" id="game-menu-auth-gate" style="display:none;">
                <div class="auth-gate-msg">🔒 需要登入才能查看</div>
                <a href="/login" class="auth-gate-link">前往登入</a>
              </div>
              <!-- Usage tab -->
              <div class="game-menu-page active" id="menu-page-usage">
                <div class="menu-usage-header">
                  <div class="menu-usage-cards">
                    <div class="usage-card">
                      <span class="usage-card-icon">💰</span>
                      <span class="usage-card-value" id="menu-cost">--</span>
                      <span class="usage-card-label">花費</span>
                    </div>
                    <div class="usage-card">
                      <span class="usage-card-icon">⚡</span>
                      <span class="usage-card-value" id="menu-queries">--</span>
                      <span class="usage-card-label">查詢</span>
                    </div>
                    <div class="usage-card">
                      <span class="usage-card-icon">📥</span>
                      <span class="usage-card-value" id="menu-input-tokens">--</span>
                      <span class="usage-card-label">IN tokens</span>
                    </div>
                    <div class="usage-card">
                      <span class="usage-card-icon">📤</span>
                      <span class="usage-card-value" id="menu-output-tokens">--</span>
                      <span class="usage-card-label">OUT tokens</span>
                    </div>
                  </div>
                  <div class="menu-usage-period">
                    <button class="period-btn active" data-days="1">24h</button>
                    <button class="period-btn" data-days="7">7d</button>
                    <button class="period-btn" data-days="30">30d</button>
                  </div>
                </div>
                <div class="menu-usage-chart">
                  <canvas id="menu-usage-canvas"></canvas>
                </div>
                <div class="menu-usage-agents" id="menu-usage-agents">
                  <div class="menu-loading">載入中...</div>
                </div>
              </div>
              <!-- Sessions tab -->
              <div class="game-menu-page" id="menu-page-sessions">
                <div class="menu-section-header">
                  <h3>進行中的任務</h3>
                  <button class="menu-action-btn" id="menu-sessions-cleanup">🧹 清理過期</button>
                </div>
                <div id="menu-sessions-list" class="menu-sessions-list">
                  <div class="menu-loading">載入中...</div>
                </div>
              </div>
              <!-- System tab -->
              <div class="game-menu-page" id="menu-page-system">
                <div class="system-stats-grid">
                  <div class="system-stat-card">
                    <span class="system-stat-icon">⏱</span>
                    <span class="system-stat-value" id="menu-sys-uptime">--</span>
                    <span class="system-stat-label">Uptime</span>
                  </div>
                  <div class="system-stat-card">
                    <span class="system-stat-icon">🧠</span>
                    <span class="system-stat-value" id="menu-sys-memory">--</span>
                    <span class="system-stat-label">Memory</span>
                  </div>
                  <div class="system-stat-card">
                    <span class="system-stat-icon">💬</span>
                    <span class="system-stat-value" id="menu-sys-sessions">--</span>
                    <span class="system-stat-label">活躍 Sessions</span>
                  </div>
                </div>
                <div class="system-memory-bar">
                  <div class="system-memory-label">
                    <span>Heap</span>
                    <span id="menu-sys-heap-text">-- / --</span>
                  </div>
                  <div class="system-bar-track">
                    <div class="system-bar-fill" id="menu-sys-heap-bar" style="width:0%"></div>
                  </div>
                </div>
                <h3 class="menu-sub-heading">Bot 狀態</h3>
                <div id="menu-sys-bots" class="menu-bots-list">
                  <div class="menu-loading">載入中...</div>
                </div>
              </div>
              <!-- Agents tab -->
              <div class="game-menu-page" id="menu-page-agents">
                <div id="menu-agents-list" class="menu-agents-list">
                  <div class="menu-loading">載入中...</div>
                </div>
              </div>
            </div>
          </div>
        </div>

      <div class="party-roster" id="party-roster">
        <!-- JS 動態渲染 -->
      </div>
      </div>

    </section>

    <!-- Right: Activity Feed (sidebar) -->
    <button class="sidebar-toggle-btn" id="sidebar-toggle-btn" title="展開側欄">◀</button>
    <aside class="office-sidebar collapsed" id="office-sidebar">
      <div class="sidebar-header">
        <h2 class="sidebar-title">📋 辦公室動態</h2>
        <div class="feed-filters" id="feed-filters">
          <button class="filter-btn active" data-filter="all">全部</button>
          <button class="filter-btn" data-filter="workflow">工作</button>
          <button class="filter-btn" data-filter="personality">心聲</button>
        </div>
      </div>
      <div class="feed-container" id="activity-feed">
        <!-- Events will be added here -->
      </div>
    </aside>
  </main>

  <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
  <script src="/static/js/live.js"></script>
</body>
</html>

<aside class="fixed inset-y-0 left-0 w-64 bg-gray-800 text-white flex flex-col">
  <!-- Logo -->
  <div class="p-4 border-b border-gray-700">
    <h1 class="text-xl font-bold flex items-center gap-2">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
      </svg>
      ClaudeCab
    </h1>
    <p class="text-gray-400 text-sm mt-1">Admin Panel</p>
  </div>

  <!-- Navigation -->
  <nav class="flex-1 mt-4 overflow-y-auto">
    <a href="/dashboard" class="flex items-center gap-3 px-4 py-3 hover:bg-gray-700 transition-colors <%= currentPath === '/dashboard' ? 'bg-gray-700 border-r-4 border-blue-500' : '' %>">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/>
      </svg>
      Dashboard
    </a>

    <a href="/agents" class="flex items-center gap-3 px-4 py-3 hover:bg-gray-700 transition-colors <%= currentPath.startsWith('/agents') ? 'bg-gray-700 border-r-4 border-blue-500' : '' %>">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
      </svg>
      Agents
    </a>

    <a href="/sessions" class="flex items-center gap-3 px-4 py-3 hover:bg-gray-700 transition-colors <%= currentPath.startsWith('/sessions') ? 'bg-gray-700 border-r-4 border-blue-500' : '' %>">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
      </svg>
      Sessions
    </a>

    <div class="border-t border-gray-700 my-4"></div>

    <a href="/api/system/health" target="_blank" class="flex items-center gap-3 px-4 py-3 hover:bg-gray-700 transition-colors text-gray-400">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
      </svg>
      Health Check
    </a>
  </nav>

  <!-- Footer -->
  <div class="p-4 border-t border-gray-700">
    <a href="/logout" class="flex items-center gap-2 text-gray-400 hover:text-white transition-colors">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
      </svg>
      Logout
    </a>
  </div>
</aside>

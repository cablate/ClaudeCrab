<%- include('../partials/start', { title }) %>

<!-- Stats Cards -->
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-6 mb-8">
  <%- include('../components/card', {
    title: 'Total Agents',
    value: stats.totalAgents,
    color: 'blue',
    icon: 'M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z'
  }) %>
  <%- include('../components/card', {
    title: 'Active Sessions',
    value: stats.activeSessions,
    color: 'green',
    icon: 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z'
  }) %>
  <%- include('../components/card', {
    title: 'Total Conversations',
    value: stats.totalConversations,
    color: 'purple',
    icon: 'M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z'
  }) %>
  <% const costColor = todayCostUsd > 5 ? 'red' : todayCostUsd > 1 ? 'yellow' : 'green'; %>
  <%- include('../components/card', {
    title: "Today's Cost",
    value: '$' + todayCostUsd.toFixed(2),
    color: costColor,
    icon: 'M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z'
  }) %>
  <%- include('../components/card', {
    title: 'System Status',
    value: stats.systemStatus === 'running' ? 'Running' : stats.systemStatus,
    color: stats.systemStatus === 'running' ? 'green' : 'red',
    icon: 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z'
  }) %>
</div>

<!-- Three Column Layout -->
<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  <!-- Agents List with Usage Stats -->
  <div class="bg-white rounded-lg shadow-sm border border-gray-200">
    <div class="px-6 py-4 border-b border-gray-200 flex items-center justify-between">
      <h3 class="text-lg font-semibold text-gray-800">Agents (24h)</h3>
      <a href="/agents" class="text-sm text-blue-600 hover:text-blue-700">View All &rarr;</a>
    </div>
    <div class="divide-y divide-gray-200 max-h-80 overflow-y-auto">
      <% if (agents.length === 0) { %>
        <%- include('../components/empty-state', {
          title: 'No agents found',
          message: 'Create an agent in the agents/ directory'
        }) %>
      <% } else { %>
        <% agents.forEach(agent => { %>
          <a href="/agents/<%= agent.id %>" class="block px-6 py-3 hover:bg-gray-50 transition-colors">
            <div class="flex items-center justify-between">
              <div class="min-w-0 flex-1">
                <p class="font-medium text-gray-900"><%= agent.name %></p>
                <p class="text-xs text-gray-500"><%= agent.id %></p>
              </div>
              <% if (agent.usage) { %>
                <div class="text-right ml-4 flex-shrink-0">
                  <p class="text-sm font-semibold text-gray-900">$<%= agent.usage.totalCostUsd.toFixed(3) %></p>
                  <p class="text-xs text-gray-500"><%= agent.usage.totalQueries %> queries</p>
                </div>
              <% } else { %>
                <div class="text-right ml-4 flex-shrink-0">
                  <p class="text-xs text-gray-400">No activity</p>
                </div>
              <% } %>
            </div>
            <% if (agent.usage) { %>
              <div class="mt-2 flex gap-3 text-xs text-gray-500">
                <span title="Input tokens">IN: <%= (agent.usage.totalInputTokens / 1000).toFixed(1) %>k</span>
                <span title="Output tokens">OUT: <%= (agent.usage.totalOutputTokens / 1000).toFixed(1) %>k</span>
                <span title="Average response time">Avg: <%= (agent.usage.avgDurationMs / 1000).toFixed(1) %>s</span>
              </div>
            <% } %>
          </a>
        <% }) %>
      <% } %>
    </div>
  </div>

  <!-- Bot Status Card -->
  <div class="bg-white rounded-lg shadow-sm border border-gray-200">
    <div class="px-6 py-4 border-b border-gray-200 flex items-center justify-between">
      <h3 class="text-lg font-semibold text-gray-800">Bot Status</h3>
      <a href="/system" class="text-sm text-blue-600 hover:text-blue-700">System &rarr;</a>
    </div>
    <div class="divide-y divide-gray-200 max-h-64 overflow-y-auto">
      <% if (botStatus.length === 0) { %>
        <div class="p-6 text-center text-gray-500 text-sm">No bots configured</div>
      <% } else { %>
        <% botStatus.forEach(bot => { %>
          <div class="px-6 py-3 flex items-center justify-between">
            <div class="flex items-center gap-3">
              <% if (bot.status === 'running') { %>
                <span class="w-2 h-2 bg-green-500 rounded-full animate-pulse"></span>
              <% } else if (bot.status === 'error') { %>
                <span class="w-2 h-2 bg-red-500 rounded-full"></span>
              <% } else if (bot.status === 'stopped') { %>
                <span class="w-2 h-2 bg-gray-400 rounded-full"></span>
              <% } else { %>
                <span class="w-2 h-2 bg-gray-300 rounded-full"></span>
              <% } %>
              <div>
                <p class="font-medium text-gray-900 text-sm"><%= bot.agentName %></p>
                <p class="text-xs text-gray-500"><%= bot.platform %></p>
              </div>
            </div>
            <span class="px-2 py-0.5 text-xs font-medium rounded-full
              <% if (bot.status === 'running') { %>bg-green-100 text-green-800
              <% } else if (bot.status === 'error') { %>bg-red-100 text-red-800
              <% } else if (bot.status === 'stopped') { %>bg-gray-100 text-gray-600
              <% } else { %>bg-gray-50 text-gray-400<% } %>">
              <%= bot.status %>
            </span>
          </div>
        <% }) %>
      <% } %>
    </div>
  </div>

  <!-- Sessions by Platform -->
  <div class="bg-white rounded-lg shadow-sm border border-gray-200">
    <div class="px-6 py-4 border-b border-gray-200 flex items-center justify-between">
      <h3 class="text-lg font-semibold text-gray-800">Sessions</h3>
      <a href="/sessions" class="text-sm text-blue-600 hover:text-blue-700">View All &rarr;</a>
    </div>
    <div class="p-6">
      <% const platforms = Object.keys(sessionsByPlatform); %>
      <% if (platforms.length === 0) { %>
        <div class="text-center text-gray-500 text-sm">No active sessions</div>
      <% } else { %>
        <div class="space-y-3">
          <% platforms.forEach(platform => { %>
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-2">
                <div class="w-8 h-8 bg-blue-100 rounded-lg flex items-center justify-center">
                  <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/>
                  </svg>
                </div>
                <span class="font-medium text-gray-900 capitalize text-sm"><%= platform %></span>
              </div>
              <span class="text-xl font-bold text-gray-900"><%= sessionsByPlatform[platform] %></span>
            </div>
          <% }) %>
        </div>
      <% } %>
      <% if (processingSessions > 0) { %>
        <div class="mt-4 pt-4 border-t border-gray-200">
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 bg-yellow-500 rounded-full animate-pulse"></span>
            <span class="text-sm text-yellow-700"><%= processingSessions %> processing</span>
          </div>
        </div>
      <% } %>
    </div>
  </div>
</div>

<!-- Bottom Section: Activity Stats + Recent Events -->
<div class="mt-6 grid grid-cols-1 lg:grid-cols-2 gap-6">
  <!-- Recent Activity Stats -->
  <div class="bg-white rounded-lg shadow-sm border border-gray-200">
    <div class="px-6 py-4 border-b border-gray-200">
      <h3 class="text-lg font-semibold text-gray-800">Activity (24h)</h3>
    </div>
    <div class="p-6">
      <div class="grid grid-cols-2 gap-6">
        <div class="text-center">
          <p class="text-4xl font-bold text-gray-900"><%= recentActivity.newSessions %></p>
          <p class="text-sm text-gray-500 mt-1">New Sessions</p>
        </div>
        <div class="text-center">
          <p class="text-4xl font-bold text-gray-900"><%= recentActivity.activeUsers %></p>
          <p class="text-sm text-gray-500 mt-1">Active Users</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Recent Events -->
  <div class="bg-white rounded-lg shadow-sm border border-gray-200">
    <div class="px-6 py-4 border-b border-gray-200 flex items-center justify-between">
      <h3 class="text-lg font-semibold text-gray-800">Recent Events</h3>
      <a href="/system/events" class="text-sm text-blue-600 hover:text-blue-700">View All &rarr;</a>
    </div>
    <div class="divide-y divide-gray-200 max-h-48 overflow-y-auto">
      <% if (recentEvents.length === 0) { %>
        <div class="p-6 text-center text-gray-500 text-sm">No recent events</div>
      <% } else { %>
        <% recentEvents.forEach(event => { %>
          <div class="px-6 py-3">
            <div class="flex items-center justify-between">
              <span class="text-xs font-medium px-2 py-0.5 rounded
                <% if (event.type.includes('error')) { %>bg-red-100 text-red-700
                <% } else if (event.type.includes('created')) { %>bg-green-100 text-green-700
                <% } else if (event.type.includes('closed')) { %>bg-yellow-100 text-yellow-700
                <% } else { %>bg-gray-100 text-gray-600<% } %>">
                <%= event.type %>
              </span>
              <span class="text-xs text-gray-400"><%= new Date(event.timestamp).toLocaleTimeString('zh-TW') %></span>
            </div>
            <p class="text-sm text-gray-700 mt-1 truncate"><%= event.summary %></p>
          </div>
        <% }) %>
      <% } %>
    </div>
  </div>
</div>

<%- include('../partials/end') %>
